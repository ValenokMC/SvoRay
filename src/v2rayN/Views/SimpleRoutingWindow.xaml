<Window
    x:Class="v2rayN.Views.SimpleRoutingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Маршрутизация"
    Width="520"
    Height="620"
    Background="#141A2E"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <Style x:Key="RouteModeCard" TargetType="{x:Type RadioButton}">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border
                            x:Name="CardGlass"
                            Padding="14,11"
                            Background="#14FFFFFF"
                            BorderBrush="#28FFFFFF"
                            BorderThickness="1"
                            CornerRadius="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse
                                    Width="16"
                                    Height="16"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="0,2,0,0"
                                    Stroke="#7FBBD2E4"
                                    StrokeThickness="1.4" />
                                <Ellipse
                                    x:Name="Dot"
                                    Width="9"
                                    Height="9"
                                    Margin="3.5,5.5,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Fill="#5EEFD2"
                                    Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardGlass" Property="Background" Value="#1EFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CardGlass" Property="Background" Value="#2143DDBB" />
                                <Setter TargetName="CardGlass" Property="BorderBrush" Value="#6B72F5D7" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock
                FontSize="12"
                Foreground="#94B8C6D8"
                Text="КАК ПРИМЕНЯТЬ СПИСОК" />
            <RadioButton
                x:Name="rdoBypassListed"
                Margin="0,9,0,8"
                GroupName="RouteMode"
                Style="{StaticResource RouteModeCard}">
                <StackPanel>
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Всё через VPN, кроме списка" />
                    <TextBlock
                        Margin="0,3,0,0"
                        FontSize="12"
                        Foreground="#A7C3D0E0"
                        Text="Домены из списка идут напрямую — например банк или локальные сервисы."
                        TextWrapping="Wrap" />
                </StackPanel>
            </RadioButton>
            <RadioButton
                x:Name="rdoProxyListed"
                GroupName="RouteMode"
                Style="{StaticResource RouteModeCard}">
                <StackPanel>
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Через VPN только список" />
                    <TextBlock
                        Margin="0,3,0,0"
                        FontSize="12"
                        Foreground="#A7C3D0E0"
                        Text="Остальной трафик идёт напрямую. Пустой список означает, что VPN не используется вовсе."
                        TextWrapping="Wrap" />
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="txtDomain"
                Height="44"
                Padding="14,10"
                materialDesign:HintAssist.Hint="example.com"
                Background="#1CFFFFFF"
                BorderBrush="#3CFFFFFF"
                BorderThickness="1"
                CaretBrush="White"
                Foreground="White"
                MaxLines="1" />
            <Button
                x:Name="btnAddDomain"
                Grid.Column="1"
                Width="112"
                Height="44"
                Margin="10,0,0,0"
                BorderThickness="0"
                Content="Добавить"
                Foreground="White">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#6C6EF7" />
                        <GradientStop Offset="1" Color="#35CDB8" />
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
        </Grid>

        <Border
            Grid.Row="2"
            Background="#12FFFFFF"
            BorderBrush="#26FFFFFF"
            BorderThickness="1"
            CornerRadius="14">
            <Grid>
                <TextBlock
                    x:Name="txtEmptyList"
                    Margin="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    Foreground="#8FB0BFD2"
                    Text="Список пуст. Добавьте домен — поддомены попадут в правило автоматически."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <ListBox
                    x:Name="lstDomains"
                    Margin="6"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalContentAlignment="Stretch"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="2,3"
                                Padding="13,9"
                                Background="#18FFFFFF"
                                BorderBrush="#26FFFFFF"
                                BorderThickness="1"
                                CornerRadius="11">
                                <DockPanel LastChildFill="False">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Left"
                                        Foreground="White"
                                        Text="{Binding}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding}" />
                                    <Button
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="BtnRemoveDomain_Click"
                                        DockPanel.Dock="Right"
                                        Foreground="#E8A9A9"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Tag="{Binding}"
                                        ToolTip="Удалить из списка">
                                        <materialDesign:PackIcon
                                            Width="17"
                                            Height="17"
                                            Kind="Close" />
                                    </Button>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <TextBlock
            x:Name="txtStatus"
            Grid.Row="3"
            Margin="2,10,2,0"
            FontSize="12"
            Foreground="#F0A9A9"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <StackPanel
            Grid.Row="4"
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="btnCancel"
                Width="120"
                Height="42"
                Margin="0,0,10,0"
                Background="Transparent"
                BorderBrush="#35FFFFFF"
                BorderThickness="1"
                Content="Отмена"
                Foreground="White" />
            <Button
                x:Name="btnSave"
                Width="140"
                Height="42"
                BorderThickness="0"
                Content="Сохранить"
                Foreground="White">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#6C6EF7" />
                        <GradientStop Offset="1" Color="#35CDB8" />
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
        </StackPanel>
    </Grid>
</Window>

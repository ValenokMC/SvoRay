<base:WindowBase
    x:Class="v2rayN.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
    xmlns:view="clr-namespace:v2rayN.Views"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="SvoRay"
    Width="420"
    Height="780"
    MinWidth="360"
    MinHeight="560"
    x:TypeArguments="vms:MainWindowViewModel"
    Icon="/Resources/SvoRay.ico"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="True"
    Background="#111526"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Popupbox.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

            <Style x:Key="SvoRayGlassComboBoxItem" TargetType="{x:Type ComboBoxItem}">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Margin" Value="5,3" />
                <Setter Property="Padding" Value="13,9" />
                <Setter Property="Foreground" Value="#EAF7FFFF" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                            <Border
                                x:Name="ItemGlass"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="26" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter
                                        VerticalAlignment="Center"
                                        Content="{TemplateBinding Content}"
                                        ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                                    <materialDesign:PackIcon
                                        x:Name="SelectedCheck"
                                        Grid.Column="1"
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Foreground="#68F3D4"
                                        Kind="Check"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemGlass" Property="Background" Value="#20FFFFFF" />
                                    <Setter TargetName="ItemGlass" Property="BorderBrush" Value="#28FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="ItemGlass" Property="Background" Value="#2BFFFFFF" />
                                    <Setter TargetName="ItemGlass" Property="BorderBrush" Value="#35FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemGlass" Property="Background" Value="#3543DDBB" />
                                    <Setter TargetName="ItemGlass" Property="BorderBrush" Value="#6B72F5D7" />
                                    <Setter TargetName="SelectedCheck" Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SvoRayGlassComboBox" TargetType="{x:Type ComboBox}">
                <Setter Property="Background" Value="#1FFFFFFF" />
                <Setter Property="BorderBrush" Value="#40FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <!--  5 rows of 44 + 6 margin, plus the 5 padding of the popup border on both sides  -->
                <Setter Property="MaxDropDownHeight" Value="260" />
                <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource SvoRayGlassComboBoxItem}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ComboBox}">
                            <Grid>
                                <Border
                                    x:Name="FieldGlass"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="13">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="42" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter
                                            Margin="{TemplateBinding Padding}"
                                            VerticalAlignment="Center"
                                            Content="{TemplateBinding SelectedItem}"
                                            ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                            ContentTemplate="{TemplateBinding ItemTemplate}"
                                            IsHitTestVisible="False" />
                                        <Border
                                            Grid.Column="1"
                                            Width="1"
                                            Height="22"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="#24FFFFFF" />
                                        <materialDesign:PackIcon
                                            x:Name="DropArrow"
                                            Grid.Column="1"
                                            Width="20"
                                            Height="20"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="#C4E0EAF4"
                                            Kind="ChevronDown" />
                                    </Grid>
                                </Border>

                                <!--
                                    Style="{x:Null}" is required: MaterialDesign2.Defaults.xaml registers an
                                    implicit ToggleButton style (a fixed-size switch). Without opting out, this
                                    hit-target shrinks to a few pixels and the field stops opening the list.
                                -->
                                <ToggleButton
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ClickMode="Press"
                                    Focusable="False"
                                    IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                    IsTabStop="False"
                                    Style="{x:Null}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <Popup
                                    x:Name="PART_Popup"
                                    AllowsTransparency="True"
                                    Focusable="False"
                                    IsOpen="{TemplateBinding IsDropDownOpen}"
                                    Placement="Bottom"
                                    PopupAnimation="Fade"
                                    StaysOpen="False">
                                    <!--
                                        Width, not MinWidth: the popup must match the field exactly, whatever the
                                        profile names are. Bound to the templated parent rather than to
                                        PlacementTarget, which this template never assigns.
                                    -->
                                    <Grid
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,8,0,8">
                                        <Border
                                            Padding="5"
                                            Background="#F226324D"
                                            BorderBrush="#54FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="18">
                                            <Border.Effect>
                                                <DropShadowEffect
                                                    BlurRadius="30"
                                                    Color="#080D1C"
                                                    Direction="270"
                                                    Opacity="0.72"
                                                    ShadowDepth="10" />
                                            </Border.Effect>
                                            <ScrollViewer
                                                HorizontalScrollBarVisibility="Disabled"
                                                SnapsToDevicePixels="True"
                                                VerticalScrollBarVisibility="Auto">
                                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="FieldGlass" Property="Background" Value="#2BFFFFFF" />
                                    <Setter TargetName="FieldGlass" Property="BorderBrush" Value="#62FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="FieldGlass" Property="BorderBrush" Value="#815EEFD2" />
                                </Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter TargetName="FieldGlass" Property="Background" Value="#30FFFFFF" />
                                    <Setter TargetName="FieldGlass" Property="BorderBrush" Value="#A35EEFD2" />
                                    <Setter TargetName="DropArrow" Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="180" CenterX="10" CenterY="10" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                Segmented control for the connection mode. RadioButton rather than ToggleButton:
                the two options are mutually exclusive, and a radio group gives that to keyboard
                and screen-reader users without any extra code.
            -->
            <Style x:Key="SvoRaySegmentButton" TargetType="{x:Type RadioButton}">
                <Setter Property="Foreground" Value="#B4CBDAE8" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RadioButton}">
                            <Border
                                x:Name="SegmentGlass"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="11">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SegmentGlass" Property="Background" Value="#1CFFFFFF" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="SegmentGlass" Property="Background" Value="#3543DDBB" />
                                    <Setter TargetName="SegmentGlass" Property="BorderBrush" Value="#6B72F5D7" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <materialDesign:DialogHost
        materialDesign:TransitionAssist.DisableTransitions="True"
        CloseOnClickAway="True"
        Identifier="RootDialog"
        SnackbarMessageQueue="{Binding ElementName=MainSnackbar, Path=MessageQueue}"
        Style="{StaticResource MaterialDesignEmbeddedDialogHost}">
        <Grid>
            <DockPanel x:Name="AdvancedPanel" Visibility="Collapsed">
                <ToolBarTray DockPanel.Dock="Top">
                    <ToolBar
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ClipToBounds="True"
                        KeyboardNavigation.TabNavigation="Continue"
                        Style="{StaticResource MaterialDesignToolBar}">
                        <Menu Margin="0,1" Style="{StaticResource ToolbarMenu}">
                            <MenuItem Padding="{StaticResource MarginLeftRight8}" AutomationProperties.Name="{x:Static resx:ResUI.menuServers}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="{StaticResource MarginRight8}"
                                            VerticalAlignment="Center"
                                            Kind="Server" />
                                        <TextBlock Text="{x:Static resx:ResUI.menuServers}" />
                                    </StackPanel>
                                </MenuItem.Header>
                                <MenuItem
                                    x:Name="menuAddServerViaClipboard"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddServerViaClipboard}"
                                    InputGestureText="Ctrl+V" />
                                <MenuItem
                                    x:Name="menuAddServerViaScan"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddServerViaScan}"
                                    InputGestureText="Ctrl+S" />
                                <MenuItem
                                    x:Name="menuAddServerViaImage"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddServerViaImage}" />
                                <MenuItem
                                    x:Name="menuAddCustomServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddCustomServer}" />
                                <MenuItem
                                    x:Name="menuAddPolicyGroupServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddPolicyGroupServer}" />
                                <MenuItem
                                    x:Name="menuAddProxyChainServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddProxyChainServer}" />
                                <Separator Margin="-40,5" />
                                <MenuItem
                                    x:Name="menuAddVmessServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddVmessServer}" />
                                <MenuItem
                                    x:Name="menuAddVlessServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddVlessServer}" />
                                <MenuItem
                                    x:Name="menuAddShadowsocksServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddShadowsocksServer}" />
                                <MenuItem
                                    x:Name="menuAddTrojanServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddTrojanServer}" />
                                <MenuItem
                                    x:Name="menuAddHysteria2Server"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddHysteria2Server}" />
                                <MenuItem
                                    x:Name="menuAddWireguardServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddWireguardServer}" />
                                <MenuItem
                                    x:Name="menuAddSocksServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddSocksServer}" />
                                <MenuItem
                                    x:Name="menuAddHttpServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddHttpServer}" />
                                <Separator Margin="-40,5" />
                                <MenuItem
                                    x:Name="menuAddTuicServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddTuicServer}" />
                                <MenuItem
                                    x:Name="menuAddAnytlsServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddAnytlsServer}" />
                                <MenuItem
                                    x:Name="menuAddNaiveServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddNaiveServer}" />
                            </MenuItem>
                        </Menu>
                        <Separator />
                        <Menu Margin="0,1" Style="{StaticResource ToolbarMenu}">
                            <MenuItem Padding="{StaticResource MarginLeftRight8}" AutomationProperties.Name="{x:Static resx:ResUI.menuSubscription}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="{StaticResource MarginRight8}"
                                            VerticalAlignment="Center"
                                            Kind="BookClockOutline" />
                                        <TextBlock Text="{x:Static resx:ResUI.menuSubscription}" />
                                    </StackPanel>
                                </MenuItem.Header>
                                <MenuItem
                                    x:Name="menuSubSetting"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuSubSetting}" />
                                <Separator Margin="-40,5" />
                                <MenuItem
                                    x:Name="menuSubUpdate"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuSubUpdate}" />
                                <MenuItem
                                    x:Name="menuSubUpdateViaProxy"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuSubUpdateViaProxy}" />
                                <MenuItem
                                    x:Name="menuSubGroupUpdate"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuSubGroupUpdate}" />
                                <MenuItem
                                    x:Name="menuSubGroupUpdateViaProxy"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuSubGroupUpdateViaProxy}" />
                            </MenuItem>
                        </Menu>
                        <Separator />
                        <Menu Margin="0,1" Style="{StaticResource ToolbarMenu}">
                            <MenuItem Padding="{StaticResource MarginLeftRight8}" AutomationProperties.Name="{x:Static resx:ResUI.menuSetting}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="{StaticResource MarginRight8}"
                                            VerticalAlignment="Center"
                                            Kind="SettingsOutline" />
                                        <TextBlock Text="{x:Static resx:ResUI.menuSetting}" />
                                    </StackPanel>
                                </MenuItem.Header>
                                <MenuItem
                                    x:Name="menuOptionSetting"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuOptionSetting}" />
                                <MenuItem
                                    x:Name="menuRoutingSetting"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuRoutingSetting}" />
                                <MenuItem
                                    x:Name="menuDNSSetting"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuDNSSetting}" />
                                <MenuItem
                                    x:Name="menuFullConfigTemplate"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuFullConfigTemplate}" />
                                <MenuItem
                                    x:Name="menuGlobalHotkeySetting"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuGlobalHotkeySetting}" />
                                <Separator Margin="-40,5" />
                                <MenuItem
                                    x:Name="menuRebootAsAdmin"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuRebootAsAdmin}" />
                                <MenuItem
                                    x:Name="menuSettingsSetUWP"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.TbSettingsSetUWP}" />
                                <MenuItem
                                    x:Name="menuClearServerStatistics"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuClearServerStatistics}" />
                                <Separator Margin="-40,5" />
                                <MenuItem Height="{StaticResource MenuItemHeight}" Header="{x:Static resx:ResUI.menuRegionalPresets}">
                                    <MenuItem
                                        x:Name="menuRegionalPresetsDefault"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuRegionalPresetsDefault}" />
                                    <MenuItem
                                        x:Name="menuRegionalPresetsRussia"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuRegionalPresetsRussia}" />
                                    <MenuItem
                                        x:Name="menuRegionalPresetsIran"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuRegionalPresetsIran}" />
                                </MenuItem>
                                <MenuItem
                                    x:Name="menuBackupAndRestore"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuBackupAndRestore}" />
                                <MenuItem
                                    x:Name="menuOpenTheFileLocation"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuOpenTheFileLocation}" />
                            </MenuItem>
                        </Menu>
                        <Separator />
                        <Menu Margin="0,1" Style="{StaticResource ToolbarMenu}">
                            <MenuItem
                                x:Name="menuHelp"
                                Padding="{StaticResource MarginLeftRight8}"
                                AutomationProperties.Name="{x:Static resx:ResUI.menuHelp}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="{StaticResource MarginRight8}"
                                            VerticalAlignment="Center"
                                            Kind="HelpCircleOutline" />
                                        <TextBlock Text="{x:Static resx:ResUI.menuHelp}" />
                                    </StackPanel>
                                </MenuItem.Header>
                                <MenuItem x:Name="menuCheckUpdate" Header="{x:Static resx:ResUI.menuCheckUpdate}" />
                                <Separator Margin="-40,5" />
                            </MenuItem>
                        </Menu>
                        <Separator />
                        <Menu Margin="0,1" Style="{StaticResource ToolbarMenu}">
                            <MenuItem
                                x:Name="menuReload"
                                Padding="{StaticResource MarginLeftRight8}"
                                AutomationProperties.Name="{x:Static resx:ResUI.menuReload}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="{StaticResource MarginRight8}"
                                            VerticalAlignment="Center"
                                            Kind="Reload" />
                                        <TextBlock Text="{x:Static resx:ResUI.menuReload}" />
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                        </Menu>
                        <Separator />
                        <Menu Margin="0,1" Style="{StaticResource ToolbarMenu}">
                            <MenuItem
                                x:Name="menuPromotion"
                                Padding="{StaticResource MarginLeftRight8}"
                                AutomationProperties.Name="{x:Static resx:ResUI.menuPromotion}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="{StaticResource MarginRight8}"
                                            VerticalAlignment="Center"
                                            Kind="VolumeHigh" />
                                        <TextBlock Text="{x:Static resx:ResUI.menuPromotion}" />
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                        </Menu>
                        <Separator />
                        <Menu Margin="0,1" Style="{StaticResource ToolbarMenu}">
                            <MenuItem
                                x:Name="menuClose"
                                Padding="{StaticResource MarginLeftRight8}"
                                AutomationProperties.Name="{x:Static resx:ResUI.menuClose}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="{StaticResource MarginRight8}"
                                            VerticalAlignment="Center"
                                            Kind="Minimize" />
                                        <TextBlock Text="{x:Static resx:ResUI.menuClose}" />
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                        </Menu>

                        <Button
                            x:Name="btnSimpleMode"
                            Margin="10,0,2,0"
                            Padding="14,7"
                            Background="#1FFFFFFF"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1"
                            Content="{x:Static resx:ResUI.SvoRaySimpleMode}"
                            Foreground="White" />

                        <materialDesign:PopupBox
                            Padding="-2"
                            HorizontalAlignment="Right"
                            StaysOpen="True"
                            Style="{StaticResource MaterialDesignToolForegroundPopupBox}">
                            <ContentControl x:Name="pbTheme" />
                        </materialDesign:PopupBox>

                        <Button
                            x:Name="btnNewUpdate"
                            Margin="{StaticResource MarginLeftRight8}"
                            Content="{x:Static resx:ResUI.menuNewUpdate}"
                            Style="{StaticResource DefButton}"
                            Visibility="Hidden" />
                    </ToolBar>
                </ToolBarTray>

                <ContentControl x:Name="contentStatusBarView" DockPanel.Dock="Bottom" />

                <Grid>
                    <Grid x:Name="gridMain" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl x:Name="tabProfiles" Grid.Column="0" />
                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />
                        <TabControl
                            x:Name="tabMain"
                            Grid.Column="2"
                            HorizontalContentAlignment="Left">
                            <TabItem x:Name="tabMsgView" Header="{x:Static resx:ResUI.MsgInformationTitle}" />
                            <TabItem x:Name="tabClashProxies" Header="{x:Static resx:ResUI.TbProxies}" />
                            <TabItem x:Name="tabClashConnections" Header="{x:Static resx:ResUI.TbConnections}" />
                        </TabControl>
                    </Grid>
                    <Grid x:Name="gridMain1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>
                        <ContentControl x:Name="tabProfiles1" Grid.Row="0" />
                        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" />
                        <TabControl
                            x:Name="tabMain1"
                            Grid.Row="2"
                            materialDesign:NavigationRailAssist.ShowSelectionBackground="True"
                            Style="{StaticResource MaterialDesignNavigationRailTabControl}"
                            TabStripPlacement="Left">
                            <TabItem x:Name="tabMsgView1">
                                <TabItem.Header>
                                    <StackPanel>
                                        <materialDesign:PackIcon HorizontalAlignment="Center" Kind="MessageTextOutline" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource ToolbarTextBlock}"
                                            Text="{x:Static resx:ResUI.MsgInformationTitle}" />
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                            <TabItem x:Name="tabClashProxies1">
                                <TabItem.Header>
                                    <StackPanel>
                                        <materialDesign:PackIcon HorizontalAlignment="Center" Kind="ArrowDecisionOutline" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource ToolbarTextBlock}"
                                            Text="{x:Static resx:ResUI.TbProxies}" />
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                            <TabItem x:Name="tabClashConnections1">
                                <TabItem.Header>
                                    <StackPanel>
                                        <materialDesign:PackIcon HorizontalAlignment="Center" Kind="LanConnect" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource ToolbarTextBlock}"
                                            Text="{x:Static resx:ResUI.TbConnections}" />
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                        </TabControl>
                    </Grid>
                    <Grid x:Name="gridMain2" Visibility="Collapsed">
                        <TabControl
                            x:Name="tabMain2"
                            materialDesign:NavigationRailAssist.ShowSelectionBackground="True"
                            Style="{StaticResource MaterialDesignNavigationRailTabControl}"
                            TabStripPlacement="Left">
                            <TabItem x:Name="tabProfiles2">
                                <TabItem.Header>
                                    <StackPanel>
                                        <materialDesign:PackIcon HorizontalAlignment="Center" Kind="Server" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource ToolbarTextBlock}"
                                            Text="{x:Static resx:ResUI.menuServers}" />
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                            <TabItem x:Name="tabMsgView2">
                                <TabItem.Header>
                                    <StackPanel>
                                        <materialDesign:PackIcon HorizontalAlignment="Center" Kind="MessageTextOutline" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource ToolbarTextBlock}"
                                            Text="{x:Static resx:ResUI.MsgInformationTitle}" />
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                            <TabItem x:Name="tabClashProxies2">
                                <TabItem.Header>
                                    <StackPanel>
                                        <materialDesign:PackIcon HorizontalAlignment="Center" Kind="ArrowDecisionOutline" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource ToolbarTextBlock}"
                                            Text="{x:Static resx:ResUI.TbProxies}" />
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                            <TabItem x:Name="tabClashConnections2">
                                <TabItem.Header>
                                    <StackPanel>
                                        <materialDesign:PackIcon HorizontalAlignment="Center" Kind="LanConnect" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource ToolbarTextBlock}"
                                            Text="{x:Static resx:ResUI.TbConnections}" />
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </DockPanel>

            <Grid x:Name="SimplePanel" ClipToBounds="True">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#171A32" />
                        <GradientStop Offset="0.48" Color="#0E2940" />
                        <GradientStop Offset="1" Color="#211833" />
                    </LinearGradientBrush>
                </Grid.Background>

                <!--
                    Both glows are static decoration, but a BlurEffect this wide is recomputed
                    on every frame, and WPF gives an element with an Effect no dirty-rectangle
                    optimisation - it redraws the whole blurred area. Two of them made dragging
                    the window visibly stutter in simple mode while advanced mode, which has no
                    such decoration, stayed smooth. BitmapCache rasterises each glow once and
                    reuses the texture; nothing here ever changes, so the cache is never
                    invalidated. The look is unchanged - the cache stores the blurred result.
                -->
                <Ellipse
                    Width="380"
                    Height="380"
                    Margin="-180,-220,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    CacheMode="BitmapCache"
                    Fill="#334B8BFF"
                    IsHitTestVisible="False">
                    <Ellipse.Effect>
                        <BlurEffect Radius="90" />
                    </Ellipse.Effect>
                </Ellipse>
                <Ellipse
                    Width="340"
                    Height="340"
                    Margin="0,0,-170,-200"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    CacheMode="BitmapCache"
                    Fill="#2EDB70C9"
                    IsHitTestVisible="False">
                    <Ellipse.Effect>
                        <BlurEffect Radius="100" />
                    </Ellipse.Effect>
                </Ellipse>

                <Grid Margin="16,14,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Header  -->
                    <StackPanel Grid.Row="0" Margin="2,0,2,12">
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="38"
                            Height="38"
                            BorderBrush="#55FFFFFF"
                            BorderThickness="1"
                            CornerRadius="13">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#7B78FF" />
                                    <GradientStop Offset="1" Color="#31D6C4" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <materialDesign:PackIcon
                                Width="21"
                                Height="21"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Kind="ShieldCheck" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Margin="11,0,8,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontFamily="Segoe UI Variable Display"
                                FontSize="19"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="SvoRay" />
                            <TextBlock
                                Margin="1,1,0,0"
                                FontSize="11"
                                Foreground="#AFC8D5E5"
                                Text="{x:Static resx:ResUI.SvoRayPersonalVpn}" />
                        </StackPanel>

                        <!--
                            Icon only: at phone width a labelled button would take a third of the
                            header row. The tooltip and the automation name carry the wording.
                        -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Border
                                    Width="80"
                                    Height="38"
                                    Margin="0,0,8,0"
                                    Padding="2"
                                    AutomationProperties.Name="{x:Static resx:ResUI.SvoRayLanguage}"
                                    Background="#16FFFFFF"
                                    BorderBrush="#35FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    ToolTip="{x:Static resx:ResUI.SvoRayLanguageTip}">
                                    <UniformGrid Rows="1">
                                        <RadioButton
                                            x:Name="rdoLanguageRu"
                                            Height="32"
                                            Padding="6,0"
                                            Content="RU"
                                            FontSize="11"
                                            GroupName="SvoRayLanguage"
                                            Style="{StaticResource SvoRaySegmentButton}" />
                                        <RadioButton
                                            x:Name="rdoLanguageEn"
                                            Height="32"
                                            Padding="6,0"
                                            Content="EN"
                                            FontSize="11"
                                            GroupName="SvoRayLanguage"
                                            Style="{StaticResource SvoRaySegmentButton}" />
                                    </UniformGrid>
                                </Border>
                                <Button
                                    x:Name="btnAdvancedMode"
                                    Width="38"
                                    Height="38"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{x:Static resx:ResUI.SvoRayAdvancedMode}"
                                    Background="#18FFFFFF"
                                    BorderBrush="#35FFFFFF"
                                    BorderThickness="1"
                                    Foreground="White"
                                    ToolTip="{x:Static resx:ResUI.SvoRayAdvancedModeTip}">
                                    <materialDesign:PackIcon
                                        Width="19"
                                        Height="19"
                                        Foreground="White"
                                        Kind="TuneVariant" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            x:Name="txtLanguageRestartNotice"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Right"
                            FontSize="10.5"
                            Foreground="#D8E8C76A"
                            Text="{x:Static resx:ResUI.SvoRayLanguageRestartNotice}"
                            TextAlignment="Right"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <!--
                        The card scrolls rather than clips. Its height depends on the state - the
                        profile block, the routing row and the status line all come and go - and on
                        a short window the bottom of it used to be cut off with no way to reach it.
                    -->
                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <!--  One main card: status, power button, and the dynamic import/profiles block  -->
                        <Border
                            MaxWidth="520"
                            Margin="0,2"
                            Padding="20,18"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Background="#1BFFFFFF"
                            BorderBrush="#38FFFFFF"
                            BorderThickness="1"
                            CornerRadius="26">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" Opacity="0.2" ShadowDepth="8" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock
                                    x:Name="txtConnectionTitle"
                                    HorizontalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="{x:Static resx:ResUI.SvoRayVpnOff}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="txtConnectionSubtitle"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#AFC8D5E5"
                                    Text="{x:Static resx:ResUI.SvoRaySelectProfileAndConnect}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />

                                <Border
                                    Margin="0,14,0,0"
                                    Padding="3"
                                    HorizontalAlignment="Stretch"
                                    Background="#16FFFFFF"
                                    BorderBrush="#2EFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                    <UniformGrid Rows="1">
                                        <RadioButton
                                            x:Name="rdoModeProxy"
                                            AutomationProperties.Name="{x:Static resx:ResUI.SvoRayProxyMode}"
                                            Content="{x:Static resx:ResUI.SvoRayProxy}"
                                            GroupName="SvoRayMode"
                                            Style="{StaticResource SvoRaySegmentButton}"
                                            ToolTip="{x:Static resx:ResUI.SvoRaySystemProxyTip}" />
                                        <RadioButton
                                            x:Name="rdoModeTun"
                                            AutomationProperties.Name="{x:Static resx:ResUI.SvoRayTunMode}"
                                            Content="TUN"
                                            GroupName="SvoRayMode"
                                            Style="{StaticResource SvoRaySegmentButton}"
                                            ToolTip="{x:Static resx:ResUI.SvoRayTunModeTip}" />
                                    </UniformGrid>
                                </Border>

                                <ToggleButton
                                    x:Name="togSvoRayConnect"
                                    Width="132"
                                    Height="132"
                                    Margin="0,16"
                                    HorizontalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Style="{x:Null}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid>
                                                <Ellipse
                                                    x:Name="OuterGlow"
                                                    Fill="#164FA8FF"
                                                    Stroke="#40FFFFFF"
                                                    StrokeThickness="1" />
                                                <Ellipse
                                                    x:Name="InnerButton"
                                                    Margin="14"
                                                    Fill="#2CFFFFFF"
                                                    Stroke="#68FFFFFF"
                                                    StrokeThickness="1.2">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect
                                                            BlurRadius="25"
                                                            Color="#1C9BFF"
                                                            Opacity="0.42"
                                                            ShadowDepth="0" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <materialDesign:PackIcon
                                                    Width="44"
                                                    Height="44"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="White"
                                                    Kind="Power" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="InnerButton" Property="Fill" Value="#42FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="OuterGlow" Property="Fill" Value="#2843E4B5" />
                                                    <Setter TargetName="OuterGlow" Property="Stroke" Value="#8059F2CA" />
                                                    <Setter TargetName="InnerButton" Property="Fill" Value="#724BE7BD" />
                                                    <Setter TargetName="InnerButton" Property="Stroke" Value="#B8C8FFF1" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <!--  ImportState: shown while no profile exists, or on explicit "add or replace"  -->
                                <StackPanel x:Name="ImportStatePanel">
                                    <Grid Margin="2,0,2,8">
                                        <TextBlock
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="{x:Static resx:ResUI.SvoRayAddConnection}" />
                                        <Button
                                            x:Name="btnCancelImport"
                                            Height="24"
                                            Padding="8,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Content="{x:Static resx:ResUI.TbCancel}"
                                            FontSize="11.5"
                                            Foreground="#A7C3D0E0"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Visibility="Collapsed" />
                                    </Grid>
                                    <TextBox
                                        x:Name="txtSubscriptionUrl"
                                        Height="46"
                                        Padding="13,10"
                                        materialDesign:HintAssist.Hint="{x:Static resx:ResUI.SvoRaySubscriptionOrProfile}"
                                        Background="#20FFFFFF"
                                        BorderBrush="#42FFFFFF"
                                        BorderThickness="1"
                                        CaretBrush="White"
                                        Foreground="White"
                                        MaxLines="1" />
                                    <Button
                                        x:Name="btnImportSubscriptionSimple"
                                        Height="44"
                                        Margin="0,10,0,0"
                                        BorderThickness="0"
                                        Foreground="White">
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Offset="0" Color="#6C6EF7" />
                                                <GradientStop Offset="1" Color="#35CDB8" />
                                            </LinearGradientBrush>
                                        </Button.Background>
                                        <TextBlock
                                            x:Name="txtImportButton"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{x:Static resx:ResUI.SvoRayImport}" />
                                    </Button>
                                    <TextBlock
                                        x:Name="txtImportStatus"
                                        Margin="2,9,2,0"
                                        FontSize="11.5"
                                        Foreground="#F0A9A9"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />
                                </StackPanel>

                                <!--  ProfilesState: replaces the import form once at least one profile exists  -->
                                <StackPanel x:Name="ProfilesStatePanel" Visibility="Collapsed">
                                    <Grid Margin="4,0,2,6">
                                        <TextBlock
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="#94B8C6D8"
                                            Text="{x:Static resx:ResUI.SvoRayConnectionProfile}" />
                                        <Button
                                            x:Name="btnShowImport"
                                            Height="24"
                                            Padding="8,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Content="{x:Static resx:ResUI.SvoRayReplace}"
                                            FontSize="11.5"
                                            Foreground="#9FD9CE"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            ToolTip="{x:Static resx:ResUI.SvoRayReplaceTip}" />
                                    </Grid>
                                    <ComboBox
                                        x:Name="cmbSimpleServers"
                                        Height="46"
                                        Style="{StaticResource SvoRayGlassComboBox}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Text="{Binding Text}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding Text}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <!--
                                        Rows="1" with Columns left at 0 makes UniformGrid derive the
                                        column count from its visible children only. The update action
                                        disappears for a standalone profile, while check and support
                                        expand to share the row without leaving an empty column.
                                        Leaving Rows at 0 as well would not do this: for two children
                                        UniformGrid squares up to 2x2 and stacks them vertically.
                                        The negative outer margin cancels the 5px gutters so both
                                        buttons stay flush with the selector above them.
                                    -->
                                    <UniformGrid Margin="-5,10,-5,0" Rows="1">
                                        <Button
                                            x:Name="btnUpdateSimple"
                                            Height="42"
                                            Margin="5,0"
                                            Padding="4,0"
                                            Background="#18FFFFFF"
                                            BorderBrush="#35FFFFFF"
                                            BorderThickness="1"
                                            Foreground="White">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    Margin="0,0,7,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="White"
                                                    Kind="Refresh" />
                                                <TextBlock
                                                    x:Name="txtUpdateSubscription"
                                                    VerticalAlignment="Center"
                                                    FontSize="12.5"
                                                    Text="{x:Static resx:ResUI.SvoRayUpdate}" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            x:Name="btnCheckPing"
                                            Height="42"
                                            Margin="5,0"
                                            Padding="4,0"
                                            Background="#18FFFFFF"
                                            BorderBrush="#35FFFFFF"
                                            BorderThickness="1"
                                            Foreground="White"
                                            ToolTip="{x:Static resx:ResUI.SvoRayCheckProfileTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    x:Name="icoCheckPing"
                                                    Width="17"
                                                    Height="17"
                                                    Margin="0,0,7,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="White"
                                                    Kind="SpeedometerMedium" />
                                                <TextBlock
                                                    x:Name="txtCheckPing"
                                                    VerticalAlignment="Center"
                                                    FontSize="12.5"
                                                    Text="{x:Static resx:ResUI.SvoRayCheck}" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            x:Name="btnSupport"
                                            Height="42"
                                            Margin="5,0"
                                            Padding="4,0"
                                            Background="#18FFFFFF"
                                            BorderBrush="#35FFFFFF"
                                            BorderThickness="1"
                                            Foreground="White"
                                            ToolTip="{x:Static resx:ResUI.SvoRaySupportTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    Margin="0,0,7,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="White"
                                                    Kind="HelpCircleOutline" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12.5"
                                                    Text="{x:Static resx:ResUI.SvoRaySupport}" />
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                    <Button
                                        x:Name="btnSimpleRouting"
                                        Height="42"
                                        Margin="0,8,0,0"
                                        Padding="12,0"
                                        HorizontalContentAlignment="Stretch"
                                        Background="#12FFFFFF"
                                        BorderBrush="#28FFFFFF"
                                        BorderThickness="1"
                                        Foreground="White"
                                        ToolTip="{x:Static resx:ResUI.SvoRayRoutingTip}">
                                        <!--
                                            The summary takes the flexible column and trims: at phone
                                            width a long one would otherwise push the label out of
                                            the button, which is what a DockPanel did here.
                                        -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Width="17"
                                                Height="17"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Foreground="White"
                                                Kind="SitemapOutline" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="12.5"
                                                Text="{x:Static resx:ResUI.SvoRayRouting}" />
                                            <TextBlock
                                                x:Name="txtRoutingSummary"
                                                Grid.Column="2"
                                                Margin="10,0,0,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                FontSize="11.5"
                                                Foreground="#9FB8C6D8"
                                                Text="{x:Static resx:ResUI.SvoRayAllTrafficViaVpn}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Button>
                                    <!--  Transient status line: simple mode never shows the shared v2rayN notices.  -->
                                    <TextBlock
                                        x:Name="txtSimpleStatus"
                                        Margin="2,9,2,0"
                                        HorizontalAlignment="Center"
                                        FontSize="11.5"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <TextBlock
                        Grid.Row="2"
                        Margin="4,10,4,0"
                        HorizontalAlignment="Center"
                        FontSize="10.5"
                        Foreground="#70AFC1D0"
                        Text="{x:Static resx:ResUI.SvoRayPoweredByV2rayN}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Grid>
            </Grid>

            <!--
                Stays scoped to advanced mode on purpose: the shared notice stream carries
                v2rayN diagnostics, including the running server address, which has no place
                in the simple screen. Simple mode uses txtSimpleStatus instead.
            -->
            <materialDesign:Snackbar
                x:Name="MainSnackbar"
                VerticalAlignment="Bottom"
                MessageQueue="{materialDesign:MessageQueue}"
                Visibility="{Binding ElementName=AdvancedPanel, Path=Visibility}" />

            <!--
                The tray icon lives at the window root, not inside StatusBarView: that view is
                hosted in AdvancedPanel, which starts Collapsed, so it never entered the live
                visual tree in simple mode and no tray icon was created at all.
                Deliberately compact menu: state, connect, profile, update, window, exit.
                The full v2rayN commands stay available in advanced mode.
            -->
            <tb:TaskbarIcon
                x:Name="tbNotify"
                IconSource="/Resources/SvoRay.ico"
                NoLeftClickDelay="True"
                ToolTipText="SvoRay">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu Style="{StaticResource DefContextMenu}">
                        <MenuItem
                            x:Name="menuTrayState"
                            Height="{StaticResource MenuItemHeight}"
                            Header="SvoRay"
                            IsHitTestVisible="False" />
                        <Separator />
                        <MenuItem
                            x:Name="menuTrayToggle"
                            Height="{StaticResource MenuItemHeight}"
                            Header="{x:Static resx:ResUI.SvoRayEnable}" />
                        <MenuItem
                            x:Name="menuTrayProfiles"
                            Height="Auto"
                            AutomationProperties.Name="{x:Static resx:ResUI.SvoRayConnectionProfile}">
                            <MenuItem.Header>
                                <DockPanel>
                                    <ComboBox
                                        x:Name="cmbTrayServers"
                                        MaxWidth="300"
                                        materialDesign:HintAssist.Hint="{x:Static resx:ResUI.SvoRayProfile}"
                                        AutomationProperties.Name="{x:Static resx:ResUI.SvoRayConnectionProfile}"
                                        DisplayMemberPath="Text"
                                        FontSize="{DynamicResource StdFontSize}"
                                        Style="{StaticResource MaterialDesignFilledComboBox}" />
                                </DockPanel>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem
                            x:Name="menuTraySubUpdate"
                            Height="{StaticResource MenuItemHeight}"
                            Header="{x:Static resx:ResUI.menuSubUpdate}" />
                        <Separator />
                        <MenuItem
                            x:Name="menuShowWindow"
                            Height="{StaticResource MenuItemHeight}"
                            Header="{x:Static resx:ResUI.SvoRayOpenWindow}" />
                        <MenuItem
                            x:Name="menuTrayExit"
                            Height="{StaticResource MenuItemHeight}"
                            Header="{x:Static resx:ResUI.menuExit}" />
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
        </Grid>
    </materialDesign:DialogHost>
</base:WindowBase>

<base:WindowBase
    x:Class="v2rayN.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:common="clr-namespace:v2rayN.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
    xmlns:view="clr-namespace:v2rayN.Views"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="SvoRay"
    Width="420"
    Height="780"
    MinWidth="360"
    MinHeight="560"
    x:TypeArguments="vms:MainWindowViewModel"
    Icon="/Resources/SvoRay.ico"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="True"
    Background="{x:Static common:SvoRayPalette.Background}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Popupbox.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        </ResourceDictionary>
    </Window.Resources>

    <materialDesign:DialogHost
        materialDesign:TransitionAssist.DisableTransitions="True"
        CloseOnClickAway="True"
        Identifier="RootDialog"
        SnackbarMessageQueue="{Binding ElementName=MainSnackbar, Path=MessageQueue}"
        Style="{StaticResource MaterialDesignEmbeddedDialogHost}">
        <Grid>
            <DockPanel x:Name="AdvancedPanel" Visibility="Collapsed">
                <ToolBarTray DockPanel.Dock="Top">
                    <ToolBar
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ClipToBounds="True"
                        KeyboardNavigation.TabNavigation="Continue"
                        Style="{StaticResource MaterialDesignToolBar}">
                        <Menu Margin="0,1" Style="{StaticResource ToolbarMenu}">
                            <MenuItem Padding="{StaticResource MarginLeftRight8}" AutomationProperties.Name="{x:Static resx:ResUI.menuServers}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="{StaticResource MarginRight8}"
                                            VerticalAlignment="Center"
                                            Kind="Server" />
                                        <TextBlock Text="{x:Static resx:ResUI.menuServers}" />
                                    </StackPanel>
                                </MenuItem.Header>
                                <MenuItem
                                    x:Name="menuAddServerViaClipboard"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddServerViaClipboard}"
                                    InputGestureText="Ctrl+V" />
                                <MenuItem
                                    x:Name="menuAddServerViaScan"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddServerViaScan}"
                                    InputGestureText="Ctrl+S" />
                                <MenuItem
                                    x:Name="menuAddServerViaImage"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddServerViaImage}" />
                                <MenuItem
                                    x:Name="menuAddCustomServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddCustomServer}" />
                                <MenuItem
                                    x:Name="menuAddPolicyGroupServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddPolicyGroupServer}" />
                                <MenuItem
                                    x:Name="menuAddProxyChainServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddProxyChainServer}" />
                                <Separator Margin="-40,5" />
                                <MenuItem
                                    x:Name="menuAddVmessServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddVmessServer}" />
                                <MenuItem
                                    x:Name="menuAddVlessServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddVlessServer}" />
                                <MenuItem
                                    x:Name="menuAddShadowsocksServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddShadowsocksServer}" />
                                <MenuItem
                                    x:Name="menuAddTrojanServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddTrojanServer}" />
                                <MenuItem
                                    x:Name="menuAddHysteria2Server"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddHysteria2Server}" />
                                <MenuItem
                                    x:Name="menuAddWireguardServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddWireguardServer}" />
                                <MenuItem
                                    x:Name="menuAddSocksServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddSocksServer}" />
                                <MenuItem
                                    x:Name="menuAddHttpServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddHttpServer}" />
                                <Separator Margin="-40,5" />
                                <MenuItem
                                    x:Name="menuAddTuicServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddTuicServer}" />
                                <MenuItem
                                    x:Name="menuAddAnytlsServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddAnytlsServer}" />
                                <MenuItem
                                    x:Name="menuAddNaiveServer"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuAddNaiveServer}" />
                            </MenuItem>
                        </Menu>
                        <Separator />
                        <Menu Margin="0,1" Style="{StaticResource ToolbarMenu}">
                            <MenuItem Padding="{StaticResource MarginLeftRight8}" AutomationProperties.Name="{x:Static resx:ResUI.menuSubscription}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="{StaticResource MarginRight8}"
                                            VerticalAlignment="Center"
                                            Kind="BookClockOutline" />
                                        <TextBlock Text="{x:Static resx:ResUI.menuSubscription}" />
                                    </StackPanel>
                                </MenuItem.Header>
                                <MenuItem
                                    x:Name="menuSubSetting"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuSubSetting}" />
                                <Separator Margin="-40,5" />
                                <MenuItem
                                    x:Name="menuSubUpdate"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuSubUpdate}" />
                                <MenuItem
                                    x:Name="menuSubUpdateViaProxy"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuSubUpdateViaProxy}" />
                                <MenuItem
                                    x:Name="menuSubGroupUpdate"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuSubGroupUpdate}" />
                                <MenuItem
                                    x:Name="menuSubGroupUpdateViaProxy"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuSubGroupUpdateViaProxy}" />
                            </MenuItem>
                        </Menu>
                        <Separator />
                        <Menu Margin="0,1" Style="{StaticResource ToolbarMenu}">
                            <MenuItem Padding="{StaticResource MarginLeftRight8}" AutomationProperties.Name="{x:Static resx:ResUI.menuSetting}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="{StaticResource MarginRight8}"
                                            VerticalAlignment="Center"
                                            Kind="SettingsOutline" />
                                        <TextBlock Text="{x:Static resx:ResUI.menuSetting}" />
                                    </StackPanel>
                                </MenuItem.Header>
                                <MenuItem
                                    x:Name="menuOptionSetting"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuOptionSetting}" />
                                <MenuItem
                                    x:Name="menuRoutingSetting"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuRoutingSetting}" />
                                <MenuItem
                                    x:Name="menuDNSSetting"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuDNSSetting}" />
                                <MenuItem
                                    x:Name="menuFullConfigTemplate"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuFullConfigTemplate}" />
                                <MenuItem
                                    x:Name="menuGlobalHotkeySetting"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuGlobalHotkeySetting}" />
                                <Separator Margin="-40,5" />
                                <MenuItem
                                    x:Name="menuRebootAsAdmin"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuRebootAsAdmin}" />
                                <MenuItem
                                    x:Name="menuSettingsSetUWP"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.TbSettingsSetUWP}" />
                                <MenuItem
                                    x:Name="menuClearServerStatistics"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuClearServerStatistics}" />
                                <Separator Margin="-40,5" />
                                <MenuItem Height="{StaticResource MenuItemHeight}" Header="{x:Static resx:ResUI.menuRegionalPresets}">
                                    <MenuItem
                                        x:Name="menuRegionalPresetsDefault"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuRegionalPresetsDefault}" />
                                    <MenuItem
                                        x:Name="menuRegionalPresetsRussia"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuRegionalPresetsRussia}" />
                                    <MenuItem
                                        x:Name="menuRegionalPresetsIran"
                                        Height="{StaticResource MenuItemHeight}"
                                        Header="{x:Static resx:ResUI.menuRegionalPresetsIran}" />
                                </MenuItem>
                                <MenuItem
                                    x:Name="menuBackupAndRestore"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuBackupAndRestore}" />
                                <MenuItem
                                    x:Name="menuOpenTheFileLocation"
                                    Height="{StaticResource MenuItemHeight}"
                                    Header="{x:Static resx:ResUI.menuOpenTheFileLocation}" />
                            </MenuItem>
                        </Menu>
                        <Separator />
                        <Menu Margin="0,1" Style="{StaticResource ToolbarMenu}">
                            <MenuItem
                                x:Name="menuHelp"
                                Padding="{StaticResource MarginLeftRight8}"
                                AutomationProperties.Name="{x:Static resx:ResUI.menuHelp}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="{StaticResource MarginRight8}"
                                            VerticalAlignment="Center"
                                            Kind="HelpCircleOutline" />
                                        <TextBlock Text="{x:Static resx:ResUI.menuHelp}" />
                                    </StackPanel>
                                </MenuItem.Header>
                                <MenuItem x:Name="menuCheckUpdate" Header="{x:Static resx:ResUI.menuCheckUpdate}" />
                                <Separator Margin="-40,5" />
                            </MenuItem>
                        </Menu>
                        <Separator />
                        <Menu Margin="0,1" Style="{StaticResource ToolbarMenu}">
                            <MenuItem
                                x:Name="menuReload"
                                Padding="{StaticResource MarginLeftRight8}"
                                AutomationProperties.Name="{x:Static resx:ResUI.menuReload}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="{StaticResource MarginRight8}"
                                            VerticalAlignment="Center"
                                            Kind="Reload" />
                                        <TextBlock Text="{x:Static resx:ResUI.menuReload}" />
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                        </Menu>
                        <Separator />
                        <Menu Margin="0,1" Style="{StaticResource ToolbarMenu}">
                            <MenuItem
                                x:Name="menuPromotion"
                                Padding="{StaticResource MarginLeftRight8}"
                                AutomationProperties.Name="{x:Static resx:ResUI.menuPromotion}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="{StaticResource MarginRight8}"
                                            VerticalAlignment="Center"
                                            Kind="VolumeHigh" />
                                        <TextBlock Text="{x:Static resx:ResUI.menuPromotion}" />
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                        </Menu>
                        <Separator />
                        <Menu Margin="0,1" Style="{StaticResource ToolbarMenu}">
                            <MenuItem
                                x:Name="menuClose"
                                Padding="{StaticResource MarginLeftRight8}"
                                AutomationProperties.Name="{x:Static resx:ResUI.menuClose}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="{StaticResource MarginRight8}"
                                            VerticalAlignment="Center"
                                            Kind="Minimize" />
                                        <TextBlock Text="{x:Static resx:ResUI.menuClose}" />
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                        </Menu>

                        <Button
                            x:Name="btnSimpleMode"
                            Margin="10,0,2,0"
                            Padding="14,7"
                            Background="#1FFFFFFF"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1"
                            Content="{x:Static resx:ResUI.SvoRaySimpleMode}"
                            Foreground="White" />

                        <materialDesign:PopupBox
                            Padding="-2"
                            HorizontalAlignment="Right"
                            StaysOpen="True"
                            Style="{StaticResource MaterialDesignToolForegroundPopupBox}">
                            <ContentControl x:Name="pbTheme" />
                        </materialDesign:PopupBox>

                        <Button
                            x:Name="btnNewUpdate"
                            Margin="{StaticResource MarginLeftRight8}"
                            Content="{x:Static resx:ResUI.menuNewUpdate}"
                            Style="{StaticResource DefButton}"
                            Visibility="Hidden" />
                    </ToolBar>
                </ToolBarTray>

                <ContentControl x:Name="contentStatusBarView" DockPanel.Dock="Bottom" />

                <Grid>
                    <Grid x:Name="gridMain" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl x:Name="tabProfiles" Grid.Column="0" />
                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />
                        <TabControl
                            x:Name="tabMain"
                            Grid.Column="2"
                            HorizontalContentAlignment="Left">
                            <TabItem x:Name="tabMsgView" Header="{x:Static resx:ResUI.MsgInformationTitle}" />
                            <TabItem x:Name="tabClashProxies" Header="{x:Static resx:ResUI.TbProxies}" />
                            <TabItem x:Name="tabClashConnections" Header="{x:Static resx:ResUI.TbConnections}" />
                        </TabControl>
                    </Grid>
                    <Grid x:Name="gridMain1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>
                        <ContentControl x:Name="tabProfiles1" Grid.Row="0" />
                        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" />
                        <TabControl
                            x:Name="tabMain1"
                            Grid.Row="2"
                            materialDesign:NavigationRailAssist.ShowSelectionBackground="True"
                            Style="{StaticResource MaterialDesignNavigationRailTabControl}"
                            TabStripPlacement="Left">
                            <TabItem x:Name="tabMsgView1">
                                <TabItem.Header>
                                    <StackPanel>
                                        <materialDesign:PackIcon HorizontalAlignment="Center" Kind="MessageTextOutline" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource ToolbarTextBlock}"
                                            Text="{x:Static resx:ResUI.MsgInformationTitle}" />
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                            <TabItem x:Name="tabClashProxies1">
                                <TabItem.Header>
                                    <StackPanel>
                                        <materialDesign:PackIcon HorizontalAlignment="Center" Kind="ArrowDecisionOutline" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource ToolbarTextBlock}"
                                            Text="{x:Static resx:ResUI.TbProxies}" />
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                            <TabItem x:Name="tabClashConnections1">
                                <TabItem.Header>
                                    <StackPanel>
                                        <materialDesign:PackIcon HorizontalAlignment="Center" Kind="LanConnect" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource ToolbarTextBlock}"
                                            Text="{x:Static resx:ResUI.TbConnections}" />
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                        </TabControl>
                    </Grid>
                    <Grid x:Name="gridMain2" Visibility="Collapsed">
                        <TabControl
                            x:Name="tabMain2"
                            materialDesign:NavigationRailAssist.ShowSelectionBackground="True"
                            Style="{StaticResource MaterialDesignNavigationRailTabControl}"
                            TabStripPlacement="Left">
                            <TabItem x:Name="tabProfiles2">
                                <TabItem.Header>
                                    <StackPanel>
                                        <materialDesign:PackIcon HorizontalAlignment="Center" Kind="Server" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource ToolbarTextBlock}"
                                            Text="{x:Static resx:ResUI.menuServers}" />
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                            <TabItem x:Name="tabMsgView2">
                                <TabItem.Header>
                                    <StackPanel>
                                        <materialDesign:PackIcon HorizontalAlignment="Center" Kind="MessageTextOutline" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource ToolbarTextBlock}"
                                            Text="{x:Static resx:ResUI.MsgInformationTitle}" />
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                            <TabItem x:Name="tabClashProxies2">
                                <TabItem.Header>
                                    <StackPanel>
                                        <materialDesign:PackIcon HorizontalAlignment="Center" Kind="ArrowDecisionOutline" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource ToolbarTextBlock}"
                                            Text="{x:Static resx:ResUI.TbProxies}" />
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                            <TabItem x:Name="tabClashConnections2">
                                <TabItem.Header>
                                    <StackPanel>
                                        <materialDesign:PackIcon HorizontalAlignment="Center" Kind="LanConnect" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource ToolbarTextBlock}"
                                            Text="{x:Static resx:ResUI.TbConnections}" />
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </DockPanel>

            <!--
                Simple mode. One focal element - the connect button - and a short list of rows
                under it, the way a phone's settings read. Everything is a flat solid surface from
                SvoRayTheme.xaml; there are no effects or gradients to redraw while the window
                moves or animates (see the header of that file).
            -->
            <Grid
                x:Name="SimplePanel"
                Background="{x:Static common:SvoRayPalette.Background}"
                TextElement.FontFamily="{StaticResource SvoRay.Font}"
                TextElement.Foreground="{x:Static common:SvoRayPalette.Text}">
                <Grid.Resources>
                    <!--  Every hint on this screen uses the theme card, not the advanced UI's tooltip  -->
                    <Style BasedOn="{StaticResource SvoRay.ToolTip}" TargetType="{x:Type ToolTip}" />
                </Grid.Resources>
                <Grid Margin="18,12,18,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Header: the mark and the name; help and settings as quiet icons  -->
                    <StackPanel Grid.Row="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                Orientation="Horizontal"
                                ToolTip="{x:Static resx:ResUI.SvoRayPoweredByV2rayN}"
                                VerticalAlignment="Center">
                                <Ellipse
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,9,0"
                                    VerticalAlignment="Center"
                                    Stroke="{x:Static common:SvoRayPalette.Accent}"
                                    StrokeThickness="4" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource SvoRay.DisplayFont}"
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Text="SvoRay" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button
                                    x:Name="btnSupport"
                                    AutomationProperties.Name="{x:Static resx:ResUI.SvoRaySupport}"
                                    Style="{StaticResource SvoRay.IconButton}"
                                    ToolTip="{x:Static resx:ResUI.SvoRaySupportTip}">
                                    <materialDesign:PackIcon
                                        Width="19"
                                        Height="19"
                                        Kind="HelpCircleOutline" />
                                </Button>
                                <Button
                                    x:Name="btnAdvancedMode"
                                    Margin="2,0,-6,0"
                                    AutomationProperties.Name="{x:Static resx:ResUI.SvoRayAdvancedMode}"
                                    Style="{StaticResource SvoRay.IconButton}"
                                    ToolTip="{x:Static resx:ResUI.SvoRayAdvancedModeTip}">
                                    <materialDesign:PackIcon
                                        Width="19"
                                        Height="19"
                                        Kind="TuneVariant" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            x:Name="txtLanguageRestartNotice"
                            Margin="0,6,0,0"
                            Style="{StaticResource SvoRay.Caption}"
                            Text="{x:Static resx:ResUI.SvoRayLanguageRestartNotice}"
                            TextAlignment="Right"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <!--
                        Scrolls rather than clips: the content changes with the state, and on a short
                        window its bottom used to be cut off with no way to reach it.
                    -->
                    <ScrollViewer
                        Grid.Row="1"
                        Margin="0,6,0,0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="440" VerticalAlignment="Center">
                            <ToggleButton
                                x:Name="togSvoRayConnect"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Center"
                                AutomationProperties.Name="{x:Static resx:ResUI.SvoRayEnable}"
                                Style="{StaticResource SvoRay.PowerButton}"
                                Tag="Off" />
                            <TextBlock
                                x:Name="txtConnectionTitle"
                                Margin="0,14,0,0"
                                Style="{StaticResource SvoRay.Title}"
                                Text="{x:Static resx:ResUI.SvoRayVpnOff}" />
                            <TextBlock
                                x:Name="txtConnectionSubtitle"
                                Margin="12,4,12,0"
                                HorizontalAlignment="Center"
                                Style="{StaticResource SvoRay.Caption}"
                                Text="{x:Static resx:ResUI.SvoRaySelectProfileAndConnect}"
                                TextAlignment="Center" />

                            <!--
                                Proxy on the left, TUN on the right, as in 0.4.0: the full width, two equal
                                halves. Each half has its own "i", laid over the segment rather than inside
                                the button, so pointing at it or clicking it never switches the mode.
                            -->
                            <Grid Margin="0,20,0,0">
                                <Border x:Name="segMode" Style="{StaticResource SvoRay.SegmentHost}">
                                    <UniformGrid Rows="1">
                                        <RadioButton
                                            x:Name="rdoModeProxy"
                                            AutomationProperties.Name="{x:Static resx:ResUI.SvoRayProxyMode}"
                                            Content="{x:Static resx:ResUI.SvoRayProxy}"
                                            GroupName="SvoRayMode"
                                            Style="{StaticResource SvoRaySegmentButton}" />
                                        <RadioButton
                                            x:Name="rdoModeTun"
                                            AutomationProperties.Name="{x:Static resx:ResUI.SvoRayTunMode}"
                                            Content="TUN"
                                            GroupName="SvoRayMode"
                                            Style="{StaticResource SvoRaySegmentButton}" />
                                    </UniformGrid>
                                </Border>
                                <UniformGrid Margin="3" Rows="1">
                                    <Label
                                        x:Name="iconProxyHelp"
                                        Margin="0,0,4,0"
                                        HorizontalAlignment="Right"
                                        AutomationProperties.HelpText="{x:Static resx:ResUI.SvoRayProxyModeHint}"
                                        AutomationProperties.Name="{x:Static resx:ResUI.SvoRayAboutProxyMode}"
                                        Style="{StaticResource SvoRay.HelpMark}"
                                        ToolTipService.PlacementTarget="{Binding ElementName=segMode}">
                                        <Label.ToolTip>
                                            <ToolTip>
                                                <TextBlock Text="{x:Static resx:ResUI.SvoRayProxyModeHint}" TextWrapping="Wrap" />
                                            </ToolTip>
                                        </Label.ToolTip>
                                    </Label>
                                    <Label
                                        x:Name="iconTunHelp"
                                        Margin="0,0,4,0"
                                        HorizontalAlignment="Right"
                                        AutomationProperties.HelpText="{x:Static resx:ResUI.SvoRayTunModeHint}"
                                        AutomationProperties.Name="{x:Static resx:ResUI.SvoRayAboutTunMode}"
                                        Style="{StaticResource SvoRay.HelpMark}"
                                        ToolTipService.PlacementTarget="{Binding ElementName=segMode}">
                                        <Label.ToolTip>
                                            <ToolTip>
                                                <TextBlock Text="{x:Static resx:ResUI.SvoRayTunModeHint}" TextWrapping="Wrap" />
                                            </ToolTip>
                                        </Label.ToolTip>
                                    </Label>
                                </UniformGrid>
                            </Grid>

                            <!--  ImportState: shown while no profile exists, or on explicit "add or replace"  -->
                            <StackPanel x:Name="ImportStatePanel" Margin="0,20,0,0">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        x:Name="txtImportTitle"
                                        Style="{StaticResource SvoRay.Body}"
                                        Text="{x:Static resx:ResUI.SvoRayAddConnection}" />
                                    <Button
                                        x:Name="btnCancelImport"
                                        HorizontalAlignment="Right"
                                        Content="{x:Static resx:ResUI.TbCancel}"
                                        Style="{StaticResource SvoRay.GhostButton}"
                                        Visibility="Collapsed" />
                                </Grid>
                                <TextBox
                                    x:Name="txtSubscriptionUrl"
                                    MaxLines="1"
                                    Style="{StaticResource SvoRay.TextField}"
                                    Tag="{x:Static resx:ResUI.SvoRaySubscriptionOrProfile}" />
                                <Button
                                    x:Name="btnImportSubscriptionSimple"
                                    Margin="0,10,0,0"
                                    Style="{StaticResource SvoRay.PrimaryButton}">
                                    <TextBlock x:Name="txtImportButton" Text="{x:Static resx:ResUI.SvoRayImport}" />
                                </Button>
                                <!--  A WireGuard / WARP .conf: several lines, so it comes as a file or a paste, not a link  -->
                                <Button
                                    x:Name="btnImportFileSimple"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Center"
                                    Content="{x:Static resx:ResUI.SvoRayImportFile}"
                                    Style="{StaticResource SvoRay.GhostButton}"
                                    ToolTip="{x:Static resx:ResUI.SvoRayImportFileHint}" />
                                <TextBlock
                                    x:Name="txtImportStatus"
                                    Margin="2,9,2,0"
                                    Foreground="{x:Static common:SvoRayPalette.Danger}"
                                    Style="{StaticResource SvoRay.Caption}"
                                    Visibility="Collapsed" />
                            </StackPanel>

                            <!--  ProfilesState: replaces the import form once at least one profile exists  -->
                            <StackPanel
                                x:Name="ProfilesStatePanel"
                                Margin="0,20,0,0"
                                Visibility="Collapsed">
                                <!--
                                    Everything about where servers come from sits on this line: refresh
                                    every subscription, add another source, replace the current one, and
                                    a short menu to remove one.
                                -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SvoRay.Label}" Text="{x:Static resx:ResUI.SvoRayServer}" />
                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="0,-7,-6,0"
                                        VerticalAlignment="Top"
                                        Orientation="Horizontal">
                                        <Button
                                            x:Name="btnUpdateSubscriptions"
                                            Width="28"
                                            Height="26"
                                            AutomationProperties.Name="{x:Static resx:ResUI.SvoRayUpdateSubscriptions}"
                                            Style="{StaticResource SvoRay.IconButton}"
                                            ToolTip="{x:Static resx:ResUI.SvoRayUpdateSubscriptions}">
                                            <materialDesign:PackIcon
                                                Width="15"
                                                Height="15"
                                                Kind="Refresh"
                                                RenderTransformOrigin="0.5,0.5">
                                                <materialDesign:PackIcon.RenderTransform>
                                                    <RotateTransform x:Name="rotUpdateSubscriptions" />
                                                </materialDesign:PackIcon.RenderTransform>
                                            </materialDesign:PackIcon>
                                        </Button>
                                        <Button
                                            x:Name="btnAddSource"
                                            Height="26"
                                            Padding="8,0"
                                            Content="{x:Static resx:ResUI.SvoRayAdd}"
                                            FontSize="12"
                                            Style="{StaticResource SvoRay.GhostButton}"
                                            ToolTip="{x:Static resx:ResUI.SvoRayAddTip}" />
                                        <Button
                                            x:Name="btnShowImport"
                                            Height="26"
                                            Padding="8,0"
                                            Content="{x:Static resx:ResUI.SvoRayReplace}"
                                            FontSize="12"
                                            Style="{StaticResource SvoRay.GhostButton}"
                                            ToolTip="{x:Static resx:ResUI.SvoRayReplaceTip}" />
                                        <Button
                                            x:Name="btnSourceMenu"
                                            Width="28"
                                            Height="26"
                                            AutomationProperties.Name="{x:Static resx:ResUI.SvoRayMore}"
                                            Style="{StaticResource SvoRay.IconButton}"
                                            ToolTip="{x:Static resx:ResUI.SvoRayMore}">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Kind="DotsHorizontal" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <!--
                                    The delay sits inside the server row, where it belongs: it is a
                                    property of the selected server. The button is laid over the field,
                                    left of its arrow, so a click on it measures instead of opening the list.
                                -->
                                <Grid>
                                    <ComboBox
                                        x:Name="cmbSimpleServers"
                                        Padding="14,0,104,0"
                                        Style="{StaticResource SvoRay.ComboBox}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Text="{Binding Text}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding Text}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button
                                        x:Name="btnCheckPing"
                                        Margin="0,0,36,0"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource SvoRay.GhostButton}"
                                        ToolTip="{x:Static resx:ResUI.SvoRayCheckProfileTip}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                x:Name="icoCheckPing"
                                                Width="15"
                                                Height="15"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                Foreground="{x:Static common:SvoRayPalette.TextSecondary}"
                                                Kind="SpeedometerMedium" />
                                            <TextBlock
                                                x:Name="txtCheckPing"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{x:Static common:SvoRayPalette.TextSecondary}"
                                                Text="{x:Static resx:ResUI.SvoRayCheck}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!--  The quota of the selected server's subscription, under that server  -->
                                <TextBlock
                                    x:Name="txtUsage"
                                    Margin="4,6,4,0"
                                    FontSize="12"
                                    Foreground="{x:Static common:SvoRayPalette.TextMuted}"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="Collapsed" />

                                <ToggleButton
                                    x:Name="togGameMode"
                                    Margin="0,10,0,0"
                                    AutomationProperties.Name="{x:Static resx:ResUI.SvoRayGameMode}"
                                    Style="{StaticResource SvoRay.SwitchRow}"
                                    ToolTip="{x:Static resx:ResUI.SvoRayGameModeTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="GamepadVariantOutline" Style="{StaticResource SvoRay.RowIcon}" />
                                        <TextBlock Style="{StaticResource SvoRay.Body}" Text="{x:Static resx:ResUI.SvoRayGameMode}" />
                                        <!--  Kept for screen readers; the switch already shows the state.  -->
                                        <TextBlock
                                            x:Name="txtGameModeState"
                                            Text="{x:Static resx:ResUI.SvoRayGameModeOffShort}"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                </ToggleButton>

                                <Button
                                    x:Name="btnSimpleRouting"
                                    Margin="0,8,0,0"
                                    Style="{StaticResource SvoRay.Row}"
                                    ToolTip="{x:Static resx:ResUI.SvoRayRoutingTip}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="SourceBranch" Style="{StaticResource SvoRay.RowIcon}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource SvoRay.Body}"
                                            Text="{x:Static resx:ResUI.SvoRayRouting}" />
                                        <TextBlock
                                            x:Name="txtRoutingSummary"
                                            Grid.Column="2"
                                            Margin="12,0,6,0"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource SvoRay.Caption}"
                                            Text="{x:Static resx:ResUI.SvoRayAllTrafficViaVpn}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <materialDesign:PackIcon
                                            Grid.Column="3"
                                            Width="18"
                                            Height="18"
                                            VerticalAlignment="Center"
                                            Foreground="{x:Static common:SvoRayPalette.TextMuted}"
                                            Kind="ChevronRight" />
                                    </Grid>
                                </Button>

                                <!--  Transient status line: simple mode never shows the shared v2rayN notices.  -->
                                <TextBlock
                                    x:Name="txtSimpleStatus"
                                    Margin="4,12,4,0"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource SvoRay.Caption}"
                                    TextAlignment="Center"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  Footer: SvoRay's own update on the left, language on the right  -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="btnAppUpdate"
                            Margin="-8,0,8,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SvoRay.GhostButton}"
                            ToolTip="{x:Static resx:ResUI.SvoRayUpdateTip}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse
                                    x:Name="dotAppUpdate"
                                    Width="7"
                                    Height="7"
                                    Margin="0,0,7,0"
                                    VerticalAlignment="Center"
                                    Fill="{x:Static common:SvoRayPalette.Accent}"
                                    Visibility="Collapsed" />
                                <materialDesign:PackIcon
                                    x:Name="icoAppUpdate"
                                    Width="15"
                                    Height="15"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Kind="Update" />
                                <TextBlock
                                    x:Name="txtAppUpdate"
                                    VerticalAlignment="Center"
                                    Text="{x:Static resx:ResUI.SvoRayCheckForUpdates}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                        <Border
                            Grid.Column="1"
                            Padding="2"
                            AutomationProperties.Name="{x:Static resx:ResUI.SvoRayLanguage}"
                            Style="{StaticResource SvoRay.SegmentHost}"
                            ToolTip="{x:Static resx:ResUI.SvoRayLanguageTip}">
                            <UniformGrid Rows="1">
                                <RadioButton
                                    x:Name="rdoLanguageRu"
                                    Height="24"
                                    Padding="8,0"
                                    Content="RU"
                                    FontSize="11"
                                    GroupName="SvoRayLanguage"
                                    Style="{StaticResource SvoRaySegmentButton}" />
                                <RadioButton
                                    x:Name="rdoLanguageEn"
                                    Height="24"
                                    Padding="8,0"
                                    Content="EN"
                                    FontSize="11"
                                    GroupName="SvoRayLanguage"
                                    Style="{StaticResource SvoRaySegmentButton}" />
                            </UniformGrid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!--
                Stays scoped to advanced mode on purpose: the shared notice stream carries
                v2rayN diagnostics, including the running server address, which has no place
                in the simple screen. Simple mode uses txtSimpleStatus instead.
            -->
            <materialDesign:Snackbar
                x:Name="MainSnackbar"
                VerticalAlignment="Bottom"
                MessageQueue="{materialDesign:MessageQueue}"
                Visibility="{Binding ElementName=AdvancedPanel, Path=Visibility}" />

            <!--
                The tray icon lives at the window root, not inside StatusBarView: that view is
                hosted in AdvancedPanel, which starts Collapsed, so it never entered the live
                visual tree in simple mode and no tray icon was created at all.
                Deliberately compact menu: state, connect, profile, update, window, exit.
                The full v2rayN commands stay available in advanced mode.
            -->
            <tb:TaskbarIcon
                x:Name="tbNotify"
                IconSource="/Resources/SvoRay.ico"
                NoLeftClickDelay="True"
                ToolTipText="SvoRay">
                <tb:TaskbarIcon.ContextMenu>
                    <!--  The same dark card as the "..." menu of the main screen  -->
                    <ContextMenu Style="{StaticResource SvoRay.ContextMenu}">
                        <MenuItem
                            x:Name="menuTrayState"
                            Header="SvoRay"
                            Style="{StaticResource SvoRay.MenuCaption}" />
                        <Separator Style="{StaticResource SvoRay.MenuSeparator}" />
                        <MenuItem x:Name="menuTrayToggle" Header="{x:Static resx:ResUI.SvoRayEnable}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Foreground="{x:Static common:SvoRayPalette.Accent}"
                                    Kind="Power" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <!--
                            Stays open on click: the selector inside it opens its own list, and a
                            click on it must not count as choosing a menu command.
                        -->
                        <MenuItem
                            x:Name="menuTrayProfiles"
                            AutomationProperties.Name="{x:Static resx:ResUI.SvoRayConnectionProfile}"
                            Cursor="Arrow"
                            StaysOpenOnClick="True">
                            <MenuItem.Header>
                                <!--  SvoRay.ComboBox shows items through a template, so DisplayMemberPath would print the type name  -->
                                <ComboBox
                                    x:Name="cmbTrayServers"
                                    Width="256"
                                    Height="40"
                                    AutomationProperties.Name="{x:Static resx:ResUI.SvoRayConnectionProfile}"
                                    Style="{StaticResource SvoRay.ComboBox}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem x:Name="menuTraySubUpdate" Header="{x:Static resx:ResUI.SvoRayUpdateSubscriptions}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Foreground="{x:Static common:SvoRayPalette.TextSecondary}"
                                    Kind="Refresh" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator Style="{StaticResource SvoRay.MenuSeparator}" />
                        <MenuItem x:Name="menuShowWindow" Header="{x:Static resx:ResUI.SvoRayOpenWindow}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Foreground="{x:Static common:SvoRayPalette.TextSecondary}"
                                    Kind="WindowMaximize" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="menuTrayExit" Header="{x:Static resx:ResUI.menuExit}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Foreground="{x:Static common:SvoRayPalette.TextSecondary}"
                                    Kind="Logout" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
        </Grid>
    </materialDesign:DialogHost>
</base:WindowBase>

<!--
    SvoRay design system: graphite surfaces, one mint accent, no effects.

    Performance rules every template here follows, because the previous look stuttered:
    - no Effect (BlurEffect, DropShadowEffect): WPF re-renders an element with an Effect in full
      on every frame and skips dirty-rectangle optimisation for it;
    - no gradients on large areas, only frozen solid brushes from SvoRayPalette;
    - animations touch Opacity and RenderTransform only - both are composited on the GPU and
      never trigger a layout pass.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:v2rayN.Common"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <FontFamily x:Key="SvoRay.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="SvoRay.DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <Duration x:Key="SvoRay.Fast">0:0:0.12</Duration>
    <CubicEase x:Key="SvoRay.Ease" EasingMode="EaseOut" />

    <!--  Text  -->
    <Style x:Key="SvoRay.Title" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource SvoRay.DisplayFont}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.Text}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SvoRay.Body" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.Text}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SvoRay.Caption" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.TextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SvoRay.Label" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.TextMuted}" />
        <Setter Property="Margin" Value="4,0,0,6" />
    </Style>
    <Style x:Key="SvoRay.RowIcon" TargetType="{x:Type materialDesign:PackIcon}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.TextSecondary}" />
    </Style>

    <!--  A full-width row: the building block of the main screen, like a phone's settings list  -->
    <Style x:Key="SvoRay.Row" TargetType="{x:Type ButtonBase}">
        <Setter Property="Height" Value="50" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.Text}" />
        <Setter Property="Background" Value="{x:Static common:SvoRayPalette.Surface}" />
        <Setter Property="BorderBrush" Value="{x:Static common:SvoRayPalette.Border}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border
                        x:Name="Frame"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{x:Static common:SvoRayPalette.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{x:Static common:SvoRayPalette.SurfacePressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{x:Static common:SvoRayPalette.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A row with a switch at its end, for on/off options. The knob slides with a transform
        animation; the track colour flips with the state.
    -->
    <Style x:Key="SvoRay.SwitchRow" TargetType="{x:Type ToggleButton}">
        <Setter Property="Height" Value="50" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border
                        x:Name="Frame"
                        Padding="{TemplateBinding Padding}"
                        Background="{x:Static common:SvoRayPalette.Surface}"
                        BorderBrush="{x:Static common:SvoRayPalette.Border}"
                        BorderThickness="1"
                        CornerRadius="12"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" />
                            <Border
                                x:Name="Track"
                                Grid.Column="1"
                                Width="36"
                                Height="20"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Background="{x:Static common:SvoRayPalette.Track}"
                                CornerRadius="10">
                                <Ellipse
                                    x:Name="Knob"
                                    Width="14"
                                    Height="14"
                                    Margin="3,0,0,0"
                                    HorizontalAlignment="Left"
                                    Fill="{x:Static common:SvoRayPalette.Text}">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource SvoRay.Ease}"
                                            Storyboard.TargetName="Knob"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                            To="16"
                                            Duration="{StaticResource SvoRay.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource SvoRay.Ease}"
                                            Storyboard.TargetName="Knob"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                            To="0"
                                            Duration="{StaticResource SvoRay.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Track" Property="Background" Value="{x:Static common:SvoRayPalette.Accent}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{x:Static common:SvoRayPalette.OnAccent}" />
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{x:Static common:SvoRayPalette.AccentBorder}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{x:Static common:SvoRayPalette.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{x:Static common:SvoRayPalette.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Segmented control: a quiet host with one raised option  -->
    <Style x:Key="SvoRay.SegmentHost" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="3" />
        <Setter Property="Background" Value="{x:Static common:SvoRayPalette.Surface}" />
        <Setter Property="BorderBrush" Value="{x:Static common:SvoRayPalette.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style x:Key="SvoRaySegmentButton" TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.TextSecondary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border
                        x:Name="Segment"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Segment" Property="Background" Value="{x:Static common:SvoRayPalette.SurfacePressed}" />
                            <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Tooltip: a flat card in the surface colour. No drop shadow - HasDropShadow would wrap the
        popup in the same software-rendered shadow the rest of the theme avoids.
    -->
    <Style x:Key="SvoRay.ToolTip" TargetType="{x:Type ToolTip}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="FontFamily" Value="{StaticResource SvoRay.Font}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.Text}" />
        <Setter Property="Background" Value="{x:Static common:SvoRayPalette.Surface}" />
        <Setter Property="BorderBrush" Value="{x:Static common:SvoRayPalette.BorderStrong}" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="MaxWidth" Value="340" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="LineHeight" Value="18" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Buttons  -->
    <Style x:Key="SvoRay.PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="46" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.OnAccent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="Fill"
                        Background="{x:Static common:SvoRayPalette.Accent}"
                        CornerRadius="12"
                        RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{x:Static common:SvoRayPalette.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fill" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.985" ScaleY="0.97" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SvoRay.GhostButton" TargetType="{x:Type ButtonBase}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border
                        x:Name="Frame"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{x:Static common:SvoRayPalette.SurfaceHover}" />
                            <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{x:Static common:SvoRayPalette.SurfacePressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{x:Static common:SvoRayPalette.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="SvoRay.IconButton"
        BasedOn="{StaticResource SvoRay.GhostButton}"
        TargetType="{x:Type ButtonBase}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!--  Text field with its hint in Tag, shown while the field is empty  -->
    <Style x:Key="SvoRay.TextField" TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="46" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.Text}" />
        <Setter Property="CaretBrush" Value="{x:Static common:SvoRayPalette.Accent}" />
        <Setter Property="SelectionBrush" Value="{x:Static common:SvoRayPalette.AccentBorder}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border
                        x:Name="Frame"
                        Padding="{TemplateBinding Padding}"
                        Background="{x:Static common:SvoRayPalette.Surface}"
                        BorderBrush="{x:Static common:SvoRayPalette.Border}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <Grid>
                            <TextBlock
                                x:Name="Hint"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Foreground="{x:Static common:SvoRayPalette.TextMuted}"
                                IsHitTestVisible="False"
                                Text="{TemplateBinding Tag}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="Collapsed" />
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Focusable="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{x:Static common:SvoRayPalette.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{x:Static common:SvoRayPalette.AccentBorder}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Server picker: a row that opens a list  -->
    <Style x:Key="SvoRay.ComboBoxItem" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border
                        x:Name="Item"
                        Margin="0,1"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" />
                            <materialDesign:PackIcon
                                x:Name="Check"
                                Grid.Column="1"
                                Width="16"
                                Height="16"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{x:Static common:SvoRayPalette.Accent}"
                                Kind="Check"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="{x:Static common:SvoRayPalette.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SvoRay.ComboBox" TargetType="{x:Type ComboBox}">
        <Setter Property="Height" Value="50" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MaxDropDownHeight" Value="280" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SvoRay.ComboBoxItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border
                            x:Name="Frame"
                            Background="{x:Static common:SvoRayPalette.Surface}"
                            BorderBrush="{x:Static common:SvoRayPalette.Border}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding ItemTemplate}"
                                    IsHitTestVisible="False" />
                                <materialDesign:PackIcon
                                    x:Name="Arrow"
                                    Grid.Column="1"
                                    Width="18"
                                    Height="18"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{x:Static common:SvoRayPalette.TextSecondary}"
                                    Kind="ChevronDown"
                                    RenderTransformOrigin="0.5,0.5" />
                            </Grid>
                        </Border>
                        <!--  Style="{x:Null}": MaterialDesign's implicit ToggleButton style is a fixed-size switch  -->
                        <ToggleButton
                            ClickMode="Press"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            IsTabStop="False"
                            Style="{x:Null}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            Focusable="False"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            Placement="Bottom"
                            PopupAnimation="Fade"
                            StaysOpen="False">
                            <Border
                                Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                Margin="0,6,0,0"
                                Padding="4"
                                Background="{x:Static common:SvoRayPalette.Surface}"
                                BorderBrush="{x:Static common:SvoRayPalette.BorderStrong}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{x:Static common:SvoRayPalette.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{x:Static common:SvoRayPalette.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Arrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The connect button. State comes in through Tag (Off / Connecting / On / Error) as well as
        IsChecked, so "connecting" can look different from "on". The connecting pulse animates
        the halo's opacity only.
    -->
    <Style x:Key="SvoRay.PowerButton" TargetType="{x:Type ToggleButton}">
        <Setter Property="Width" Value="132" />
        <Setter Property="Height" Value="132" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid x:Name="Body" RenderTransformOrigin="0.5,0.5">
                        <Ellipse x:Name="Halo" Fill="Transparent" />
                        <Ellipse
                            x:Name="Ring"
                            Margin="10"
                            Fill="{x:Static common:SvoRayPalette.Surface}"
                            Stroke="{x:Static common:SvoRayPalette.BorderStrong}"
                            StrokeThickness="2" />
                        <materialDesign:PackIcon
                            x:Name="Glyph"
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{x:Static common:SvoRayPalette.TextSecondary}"
                            Kind="Power" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="{x:Static common:SvoRayPalette.SurfaceHover}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{x:Static common:SvoRayPalette.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Body" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Halo" Property="Fill" Value="{x:Static common:SvoRayPalette.AccentSurface}" />
                            <Setter TargetName="Ring" Property="Fill" Value="{x:Static common:SvoRayPalette.AccentSurface}" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{x:Static common:SvoRayPalette.Accent}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{x:Static common:SvoRayPalette.Accent}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Connecting">
                            <Setter TargetName="Halo" Property="Fill" Value="{x:Static common:SvoRayPalette.WarningSurface}" />
                            <Setter TargetName="Ring" Property="Fill" Value="{x:Static common:SvoRayPalette.WarningSurface}" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{x:Static common:SvoRayPalette.Warning}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{x:Static common:SvoRayPalette.Warning}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="Pulse">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            AutoReverse="True"
                                            Storyboard.TargetName="Halo"
                                            Storyboard.TargetProperty="Opacity"
                                            From="1"
                                            To="0.25"
                                            Duration="0:0:0.7" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Pulse" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="Tag" Value="Error">
                            <Setter TargetName="Ring" Property="Stroke" Value="{x:Static common:SvoRayPalette.Danger}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{x:Static common:SvoRayPalette.Danger}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

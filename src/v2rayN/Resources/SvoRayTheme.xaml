<!--
    SvoRay design system: graphite surfaces, one mint accent, no effects.

    Performance rules every template here follows, because the previous look stuttered:
    - no Effect (BlurEffect, DropShadowEffect): WPF re-renders an element with an Effect in full
      on every frame and skips dirty-rectangle optimisation for it;
    - no gradients on large areas, only frozen solid brushes from SvoRayPalette;
    - animations touch Opacity and RenderTransform only - both are composited on the GPU and
      never trigger a layout pass.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:v2rayN.Common"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <FontFamily x:Key="SvoRay.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="SvoRay.DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <Duration x:Key="SvoRay.Fast">0:0:0.12</Duration>
    <CubicEase x:Key="SvoRay.Ease" EasingMode="EaseOut" />

    <!--  Text  -->
    <Style x:Key="SvoRay.Title" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource SvoRay.DisplayFont}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.Text}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SvoRay.Body" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.Text}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SvoRay.Caption" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.TextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SvoRay.Label" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.TextMuted}" />
        <Setter Property="Margin" Value="4,0,0,6" />
    </Style>
    <Style x:Key="SvoRay.RowIcon" TargetType="{x:Type materialDesign:PackIcon}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.TextSecondary}" />
    </Style>

    <!--  A full-width row: the building block of the main screen, like a phone's settings list  -->
    <Style x:Key="SvoRay.Row" TargetType="{x:Type ButtonBase}">
        <Setter Property="Height" Value="50" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.Text}" />
        <Setter Property="Background" Value="{x:Static common:SvoRayPalette.Surface}" />
        <Setter Property="BorderBrush" Value="{x:Static common:SvoRayPalette.Border}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border
                        x:Name="Frame"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{x:Static common:SvoRayPalette.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{x:Static common:SvoRayPalette.SurfacePressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{x:Static common:SvoRayPalette.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A row with a switch at its end, for on/off options. The knob slides with a transform
        animation; the track colour flips with the state.
    -->
    <Style x:Key="SvoRay.SwitchRow" TargetType="{x:Type ToggleButton}">
        <Setter Property="Height" Value="50" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border
                        x:Name="Frame"
                        Padding="{TemplateBinding Padding}"
                        Background="{x:Static common:SvoRayPalette.Surface}"
                        BorderBrush="{x:Static common:SvoRayPalette.Border}"
                        BorderThickness="1"
                        CornerRadius="12"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" />
                            <Border
                                x:Name="Track"
                                Grid.Column="1"
                                Width="36"
                                Height="20"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Background="{x:Static common:SvoRayPalette.Track}"
                                CornerRadius="10">
                                <Ellipse
                                    x:Name="Knob"
                                    Width="14"
                                    Height="14"
                                    Margin="3,0,0,0"
                                    HorizontalAlignment="Left"
                                    Fill="{x:Static common:SvoRayPalette.Text}">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource SvoRay.Ease}"
                                            Storyboard.TargetName="Knob"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                            To="16"
                                            Duration="{StaticResource SvoRay.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource SvoRay.Ease}"
                                            Storyboard.TargetName="Knob"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                            To="0"
                                            Duration="{StaticResource SvoRay.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Track" Property="Background" Value="{x:Static common:SvoRayPalette.Accent}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{x:Static common:SvoRayPalette.OnAccent}" />
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{x:Static common:SvoRayPalette.AccentBorder}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{x:Static common:SvoRayPalette.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{x:Static common:SvoRayPalette.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Segmented control: a quiet host with one raised option  -->
    <Style x:Key="SvoRay.SegmentHost" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="3" />
        <Setter Property="Background" Value="{x:Static common:SvoRayPalette.Surface}" />
        <Setter Property="BorderBrush" Value="{x:Static common:SvoRayPalette.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style x:Key="SvoRaySegmentButton" TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.TextSecondary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border
                        x:Name="Segment"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Segment" Property="Background" Value="{x:Static common:SvoRayPalette.SurfacePressed}" />
                            <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Tooltip: a flat card in the surface colour. No drop shadow - HasDropShadow would wrap the
        popup in the same software-rendered shadow the rest of the theme avoids.
    -->
    <Style x:Key="SvoRay.ToolTip" TargetType="{x:Type ToolTip}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="FontFamily" Value="{StaticResource SvoRay.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.Text}" />
        <Setter Property="Background" Value="{x:Static common:SvoRayPalette.Surface}" />
        <Setter Property="BorderBrush" Value="{x:Static common:SvoRayPalette.BorderStrong}" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="MaxWidth" Value="340" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="LineHeight" Value="18" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A small "i" that explains the control it sits on. A Label, not a button: screen readers
        find it and read the hint (HelpText), and a click on it does nothing - it lies over a
        segment and must not switch the mode under it. Hover and keyboard focus show the hint.
    -->
    <Style x:Key="SvoRay.HelpMark" TargetType="{x:Type Label}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.TextSecondary}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
        <Setter Property="ToolTipService.ShowDuration" Value="60000" />
        <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
        <Setter Property="ToolTipService.Placement" Value="Bottom" />
        <Setter Property="ToolTipService.VerticalOffset" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Label}">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="8">
                        <materialDesign:PackIcon
                            Width="14"
                            Height="14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{TemplateBinding Foreground}"
                            Kind="InformationOutline" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{x:Static common:SvoRayPalette.SurfaceHover}" />
                            <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Menus in the theme's colours: the "..." menu of the server row and the tray menu. An item
        shows its Icon, when it has one, left of the header.
    -->
    <Style x:Key="SvoRay.MenuItem" TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource SvoRay.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Border
                        x:Name="Row"
                        Padding="12,8"
                        Background="Transparent"
                        CornerRadius="8">
                        <DockPanel>
                            <ContentPresenter
                                x:Name="IconHost"
                                Width="18"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                ContentSource="Icon"
                                DockPanel.Dock="Left" />
                            <ContentPresenter
                                VerticalAlignment="Center"
                                ContentSource="Header"
                                RecognizesAccessKey="False" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{x:Static common:SvoRayPalette.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--  A line of text in a menu that is not a command, such as the connection state  -->
    <Style
        x:Key="SvoRay.MenuCaption"
        BasedOn="{StaticResource SvoRay.MenuItem}"
        TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
    </Style>
    <Style x:Key="SvoRay.MenuSeparator" TargetType="{x:Type Separator}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border
                        Height="1"
                        Margin="8,4"
                        Background="{x:Static common:SvoRayPalette.Border}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SvoRay.ContextMenu" TargetType="{x:Type ContextMenu}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SvoRay.MenuItem}" />
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="MaxWidth" Value="320" />
        <Setter Property="FontFamily" Value="{StaticResource SvoRay.Font}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border
                        Padding="4"
                        Background="{x:Static common:SvoRayPalette.Surface}"
                        BorderBrush="{x:Static common:SvoRayPalette.BorderStrong}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Buttons  -->
    <Style x:Key="SvoRay.PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="46" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.OnAccent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="Fill"
                        Background="{x:Static common:SvoRayPalette.Accent}"
                        CornerRadius="12"
                        RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{x:Static common:SvoRayPalette.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fill" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.985" ScaleY="0.97" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SvoRay.GhostButton" TargetType="{x:Type ButtonBase}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border
                        x:Name="Frame"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{x:Static common:SvoRayPalette.SurfaceHover}" />
                            <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{x:Static common:SvoRayPalette.SurfacePressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{x:Static common:SvoRayPalette.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="SvoRay.IconButton"
        BasedOn="{StaticResource SvoRay.GhostButton}"
        TargetType="{x:Type ButtonBase}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!--  Text field with its hint in Tag, shown while the field is empty  -->
    <Style x:Key="SvoRay.TextField" TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="46" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.Text}" />
        <Setter Property="CaretBrush" Value="{x:Static common:SvoRayPalette.Accent}" />
        <Setter Property="SelectionBrush" Value="{x:Static common:SvoRayPalette.AccentBorder}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border
                        x:Name="Frame"
                        Padding="{TemplateBinding Padding}"
                        Background="{x:Static common:SvoRayPalette.Surface}"
                        BorderBrush="{x:Static common:SvoRayPalette.Border}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <Grid>
                            <TextBlock
                                x:Name="Hint"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Foreground="{x:Static common:SvoRayPalette.TextMuted}"
                                IsHitTestVisible="False"
                                Text="{TemplateBinding Tag}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="Collapsed" />
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Focusable="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{x:Static common:SvoRayPalette.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{x:Static common:SvoRayPalette.AccentBorder}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Server picker: a row that opens a list  -->
    <Style x:Key="SvoRay.ComboBoxItem" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border
                        x:Name="Item"
                        Margin="0,1"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" />
                            <materialDesign:PackIcon
                                x:Name="Check"
                                Grid.Column="1"
                                Width="16"
                                Height="16"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{x:Static common:SvoRayPalette.Accent}"
                                Kind="Check"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="{x:Static common:SvoRayPalette.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SvoRay.ComboBox" TargetType="{x:Type ComboBox}">
        <Setter Property="Height" Value="50" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Foreground" Value="{x:Static common:SvoRayPalette.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MaxDropDownHeight" Value="280" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SvoRay.ComboBoxItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border
                            x:Name="Frame"
                            Background="{x:Static common:SvoRayPalette.Surface}"
                            BorderBrush="{x:Static common:SvoRayPalette.Border}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding ItemTemplate}"
                                    IsHitTestVisible="False" />
                                <materialDesign:PackIcon
                                    x:Name="Arrow"
                                    Grid.Column="1"
                                    Width="18"
                                    Height="18"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{x:Static common:SvoRayPalette.TextSecondary}"
                                    Kind="ChevronDown"
                                    RenderTransformOrigin="0.5,0.5" />
                            </Grid>
                        </Border>
                        <!--  Style="{x:Null}": MaterialDesign's implicit ToggleButton style is a fixed-size switch  -->
                        <ToggleButton
                            ClickMode="Press"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            IsTabStop="False"
                            Style="{x:Null}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            Focusable="False"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            Placement="Bottom"
                            PopupAnimation="Fade"
                            StaysOpen="False">
                            <Border
                                Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                Margin="0,6,0,0"
                                Padding="4"
                                Background="{x:Static common:SvoRayPalette.Surface}"
                                BorderBrush="{x:Static common:SvoRayPalette.BorderStrong}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{x:Static common:SvoRayPalette.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{x:Static common:SvoRayPalette.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Arrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The connect button. State comes in through Tag (Off / Connecting / On / Error) as well as
        IsChecked, so "connecting" can look different from "on". The connecting pulse animates
        the halo's opacity only.
    -->
    <Style x:Key="SvoRay.PowerButton" TargetType="{x:Type ToggleButton}">
        <Setter Property="Width" Value="132" />
        <Setter Property="Height" Value="132" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid x:Name="Body" RenderTransformOrigin="0.5,0.5">
                        <Ellipse x:Name="Halo" Fill="Transparent" />
                        <Ellipse
                            x:Name="Ring"
                            Margin="10"
                            Fill="{x:Static common:SvoRayPalette.Surface}"
                            Stroke="{x:Static common:SvoRayPalette.BorderStrong}"
                            StrokeThickness="2" />
                        <materialDesign:PackIcon
                            x:Name="Glyph"
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{x:Static common:SvoRayPalette.TextSecondary}"
                            Kind="Power" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="{x:Static common:SvoRayPalette.SurfaceHover}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{x:Static common:SvoRayPalette.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Body" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Halo" Property="Fill" Value="{x:Static common:SvoRayPalette.AccentSurface}" />
                            <Setter TargetName="Ring" Property="Fill" Value="{x:Static common:SvoRayPalette.AccentSurface}" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{x:Static common:SvoRayPalette.Accent}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{x:Static common:SvoRayPalette.Accent}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Connecting">
                            <Setter TargetName="Halo" Property="Fill" Value="{x:Static common:SvoRayPalette.WarningSurface}" />
                            <Setter TargetName="Ring" Property="Fill" Value="{x:Static common:SvoRayPalette.WarningSurface}" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{x:Static common:SvoRayPalette.Warning}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{x:Static common:SvoRayPalette.Warning}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="Pulse">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            AutoReverse="True"
                                            Storyboard.TargetName="Halo"
                                            Storyboard.TargetProperty="Opacity"
                                            From="1"
                                            To="0.25"
                                            Duration="0:0:0.7" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Pulse" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="Tag" Value="Error">
                            <Setter TargetName="Ring" Property="Stroke" Value="{x:Static common:SvoRayPalette.Danger}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{x:Static common:SvoRayPalette.Danger}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The advanced interface (the screens v2rayN brought along) in SvoRay's look.

        Those screens follow the app's Light / Dark / System theme, so their brushes are not the
        frozen SvoRayPalette ones above: each colour is bound to SvoRayAdaptivePalette, which
        switches with the theme, and the brushes recolour in place. Screens opt in by merging
        SvoRayAdvanced.xaml, which points MaterialDesign's colour keys and the shared Def* styles
        at what is defined here. Accent elements use MaterialDesign's primary colour: it is
        SvoRay's mint unless the user picked another colour in the theme settings.
    -->
    <SolidColorBrush x:Key="SvoRay.Brush.Background" Color="{Binding Background, Source={x:Static common:SvoRayAdaptivePalette.Current}}" />
    <SolidColorBrush x:Key="SvoRay.Brush.Surface" Color="{Binding Surface, Source={x:Static common:SvoRayAdaptivePalette.Current}}" />
    <SolidColorBrush x:Key="SvoRay.Brush.SurfaceHover" Color="{Binding SurfaceHover, Source={x:Static common:SvoRayAdaptivePalette.Current}}" />
    <SolidColorBrush x:Key="SvoRay.Brush.SurfacePressed" Color="{Binding SurfacePressed, Source={x:Static common:SvoRayAdaptivePalette.Current}}" />
    <SolidColorBrush x:Key="SvoRay.Brush.Border" Color="{Binding Border, Source={x:Static common:SvoRayAdaptivePalette.Current}}" />
    <SolidColorBrush x:Key="SvoRay.Brush.BorderStrong" Color="{Binding BorderStrong, Source={x:Static common:SvoRayAdaptivePalette.Current}}" />
    <SolidColorBrush x:Key="SvoRay.Brush.Text" Color="{Binding Text, Source={x:Static common:SvoRayAdaptivePalette.Current}}" />
    <SolidColorBrush x:Key="SvoRay.Brush.TextSecondary" Color="{Binding TextSecondary, Source={x:Static common:SvoRayAdaptivePalette.Current}}" />
    <SolidColorBrush x:Key="SvoRay.Brush.TextMuted" Color="{Binding TextMuted, Source={x:Static common:SvoRayAdaptivePalette.Current}}" />
    <SolidColorBrush x:Key="SvoRay.Brush.Track" Color="{Binding Track, Source={x:Static common:SvoRayAdaptivePalette.Current}}" />
    <SolidColorBrush x:Key="SvoRay.Brush.Knob" Color="{Binding Knob, Source={x:Static common:SvoRayAdaptivePalette.Current}}" />
    <SolidColorBrush x:Key="SvoRay.Brush.KnobOn" Color="{Binding KnobOn, Source={x:Static common:SvoRayAdaptivePalette.Current}}" />
    <SolidColorBrush x:Key="SvoRay.Brush.Danger" Color="{Binding Danger, Source={x:Static common:SvoRayAdaptivePalette.Current}}" />

    <!--
        A button of the advanced screens. Neutral by default; the dialog's default button
        (IsDefault, the one Enter presses) takes the accent fill, so "Confirm" stands out from
        "Cancel" without either line changing. Hover and press lay a faint wash of the text colour
        over whichever fill the button has, so both kinds react the same way.
    -->
    <Style x:Key="SvoRay.Adv.Button" TargetType="{x:Type ButtonBase}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="{DynamicResource StdFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource SvoRay.Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource SvoRay.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SvoRay.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border
                        x:Name="Frame"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Border
                                x:Name="Wash"
                                Background="{DynamicResource SvoRay.Brush.Text}"
                                CornerRadius="9"
                                Opacity="0" />
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Wash" Property="Opacity" Value="0.06" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Wash" Property="Opacity" Value="0.11" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource SvoRay.Brush.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Button.IsDefault" Value="True">
                <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  A small square icon button, flat until pointed at: the tool buttons above a list  -->
    <Style x:Key="SvoRay.Adv.IconButton" TargetType="{x:Type ButtonBase}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Foreground" Value="{DynamicResource SvoRay.Brush.TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border x:Name="Frame" Background="Transparent" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SvoRay.Brush.SurfaceHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource SvoRay.Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SvoRay.Brush.SurfacePressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SvoRay.Brush.SurfaceHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource SvoRay.Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  The switch of SvoRay.SwitchRow on its own, for a setting that sits next to its label  -->
    <Style x:Key="SvoRay.Adv.Switch" TargetType="{x:Type ToggleButton}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border
                        x:Name="Track"
                        Width="36"
                        Height="20"
                        Background="{DynamicResource SvoRay.Brush.Track}"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="10"
                        SnapsToDevicePixels="True">
                        <Ellipse
                            x:Name="Knob"
                            Width="14"
                            Height="14"
                            Margin="2,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Fill="{DynamicResource SvoRay.Brush.Knob}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform X="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource SvoRay.Ease}"
                                            Storyboard.TargetName="Knob"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                            To="16"
                                            Duration="{StaticResource SvoRay.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource SvoRay.Ease}"
                                            Storyboard.TargetName="Knob"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                            To="0"
                                            Duration="{StaticResource SvoRay.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource SvoRay.Brush.KnobOn}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource SvoRay.Brush.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource SvoRay.Brush.TextSecondary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Tabs as a segmented strip, like the simple screen's mode switch: a quiet host, the open
        tab raised. Only the strip changes; WPF still creates just the open tab's content.
    -->
    <Style x:Key="SvoRay.Adv.TabItem" TargetType="{x:Type TabItem}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="{DynamicResource StdFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource SvoRay.Brush.TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border
                        x:Name="Segment"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="9">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ContentSource="Header"
                            RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SvoRay.Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Segment" Property="Background" Value="{DynamicResource SvoRay.Brush.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Segment" Property="Background" Value="{DynamicResource SvoRay.Brush.SurfacePressed}" />
                            <Setter Property="Foreground" Value="{DynamicResource SvoRay.Brush.Text}" />
                            <Setter Property="Panel.ZIndex" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SvoRay.Adv.TabControl" TargetType="{x:Type TabControl}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SvoRay.Adv.TabItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <DockPanel KeyboardNavigation.TabNavigation="Local">
                        <Border
                            Margin="0,0,0,8"
                            Padding="3"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            Background="{DynamicResource SvoRay.Brush.Surface}"
                            BorderBrush="{DynamicResource SvoRay.Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="12"
                            DockPanel.Dock="Top">
                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                        </Border>
                        <ContentPresenter
                            x:Name="PART_SelectedContentHost"
                            Margin="{TemplateBinding Padding}"
                            ContentSource="SelectedContent" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  A filter chip: the subscription groups above the server table  -->
    <Style x:Key="SvoRay.Adv.ChipItem" TargetType="{x:Type ListBoxItem}">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Margin" Value="0,2,6,2" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="{DynamicResource StdFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource SvoRay.Brush.TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border
                        x:Name="Chip"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        BorderBrush="{DynamicResource SvoRay.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="9"
                        SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SvoRay.Brush.SurfaceHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource SvoRay.Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource SvoRay.Brush.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SvoRay.Brush.SurfacePressed}" />
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource SvoRay.Brush.BorderStrong}" />
                            <Setter Property="Foreground" Value="{DynamicResource SvoRay.Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  SvoRay.ToolTip in the advanced screens' colours  -->
    <Style
        x:Key="SvoRay.Adv.ToolTip"
        BasedOn="{StaticResource SvoRay.ToolTip}"
        TargetType="{x:Type ToolTip}">
        <Setter Property="Foreground" Value="{DynamicResource SvoRay.Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource SvoRay.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SvoRay.Brush.BorderStrong}" />
    </Style>
</ResourceDictionary>
